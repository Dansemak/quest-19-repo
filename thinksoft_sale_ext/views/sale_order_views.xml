<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_thinksoft_sale_ext" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!--
                limiting the partner records to type = 'contact'
                limiting invoice address records to the partner_id or any invoice contacts with the parent_id being the partner_id
                limiting shipping address records to the partner_id or any shipping contacts with the parent_id being the partner_id
            -->

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'contact'), ('parent_id', '=', False)]</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="domain">['|',
                    '&amp;', ('parent_id', '=', partner_id), ('type', '=', 'invoice'),
                    '&amp;', ('id', '=', partner_id), ('parent_id', '=', False)]
                </attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="domain">['|',
                    '&amp;', ('parent_id', '=', partner_id), ('type', '=', 'delivery'),
                    '&amp;', ('id', '=', partner_id), ('parent_id', '=', False)]
                </attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <!-- adding the customer contact field to the sales order -->

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="partner_contact_id"
                    domain="[('parent_id', '=', partner_id), ('type', '=', 'contact')]"
                    options="{'no_create': True}"/>
            </xpath>

            <!-- the outside salesperson inserted in the "Other Info" tab-->

            <xpath expr="//page[@name='other_information']//field[@name='user_id']" position="after">
                <field name="outside_salesperson_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
            </xpath>

            <!-- COO Required, Notes, Comment,Shipping Method, Freight Charge, Job Project, and End User in header -->

            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="is_coo_required"/>
                <field name="sale_note_id" options="{'no_create': True}"/>
                <field name="comment_text" placeholder="Order comments and detailed notes"/>
            </xpath>

            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="customer_end_user_id" options="{'no_create': True}"/>
                <field name="customer_job_project_id" options="{'no_create': True}"/>
                <field name="carrier_id" string="Shipping Method" options="{'no_create': True}"/>
                <field name="sale_freight_id" options="{'no_create': True}"/>
            </xpath>

            <!-- Sale Order Line Items: Tagging, Line Number -->

            <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//list//field[@name='sequence']" position="after">
                <field name="seq_no" optional="show"/>
            </xpath>

            <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <field name="tagging" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_tree_inherit_thinksoft_sale_ext" model="ir.ui.view">
        <field name="name">sale.order.view.list.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="options">{"numeric":true,"show_time":false}</attribute>
                <attribute name="widget">datetime</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="carrier_id" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_inherit_thinksoft_sale_ext" model="ir.ui.view">
        <field name="name">sale.order.view.list.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='create_date']" position="attributes">
                <attribute name="options">{"numeric":true,"show_time":false}</attribute>
                <attribute name="widget">datetime</attribute>
            </xpath>

        </field>
    </record>
</odoo>