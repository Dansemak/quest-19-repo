<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- adding relational fields to account.move views in the thinksoft_sale_ext module
    to avoid hard dependancies between extension modules -->

    <record id="view_move_form_inherit_thinksoft_sale_ext" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="sale_freight_id" invisible="move_type not in ['out_invoice', 'out_refund', 'out_receipt']"/>
            </xpath>

        </field>
    </record>

</odoo>
