<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="job_project_action_list" model="ir.actions.act_window">
        <field name="name">Job Projects</field>
        <field name="res_model">job.project</field>
        <field name="view_mode">list,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Job Project
            </p><p>
                Create a new Job Project
            </p>
        </field>
    </record>

    <record id="job_project_view_tree" model="ir.ui.view">
        <field name="name">job.project.view.tree</field>
        <field name="model">job.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="job_project_view_form" model="ir.ui.view">
        <field name="name">job.project.view.form</field>
        <field name="model">job.project</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1 class="mb-0">
                            <field name="name" class="mb-0" />
                        </h1>
                    </div>
                    <field name="active" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="job_project_view_search" model="ir.ui.view">
        <field name="name">job.project.view.search</field>
        <field name="model">job.project</field>
        <field name="arch" type="xml">
            <search>
                <filter name="archive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <menuitem
        id="sale_menu_job_project_action_list"
        action="job_project_action_list"
        parent="sale.menu_sales_config"
        sequence="7"/>

</odoo>