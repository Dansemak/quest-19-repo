<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- sales extended privilege -->
        <record model="res.groups.privilege" id="res_groups_privilege_sales_extended">
            <field name="name">Sales Extended</field>
            <field name="sequence">2</field>
            <field name="category_id" ref="base.module_category_sales"/>
        </record>

        <!-- sales extended user group (read) -->
        <record id="group_sale_extended_user" model="res.groups">
            <field name="name">User: Read Only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sales_extended"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">User can only read sales extended records.</field>
        </record>

        <!-- sales extended manager group (full access) -->
        <record id="group_sale_extended_manager" model="res.groups">
            <field name="name">Manager: Full Access</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sales_extended"/>
            <field name="implied_ids" eval="[(4, ref('group_sale_extended_user')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="comment">Manager has full CRUD access to sales extended records and menu visibility.</field>
        </record>
    </data>
</odoo>