<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_product_search_inherit_thinksoft_sale_ext" model="ir.ui.view">
        <field name="name">sale.report.view.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="outside_salesperson_id" />
            </xpath>

            <xpath expr="//filter[@name='User']" position="after">
                <filter string="Outside Salesperson" name="outside_salesperson" context="{'group_by': 'outside_salesperson_id'}" />
            </xpath>

        </field>
    </record>

</odoo>
