<odoo>

    <record id="mtr_nut_view_form" model="ir.ui.view">
        <field name="name">mtr.nut.view.form</field>
        <field name="model">mtr.template</field>
        <field name="inherit_id" ref="mtr_template_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//group[@name='main_info_group']" position="after">

            <group string="NUT Product Information" invisible="category != 'nut'">
                <group>
                    <field name="product_type"/>
                    <field name="dimension"/>
                    <field name="diameter"/>
                    <field name="description"/>
                    <field name="manufacturer_id"/>
                    <field name="country_of_origin"/>
                    <field name="standard"/>
                    <field name="material"/>
                    <field name="marking"/>
                    <field name="lot_batch_number"/>
                    <field name="reference"/>
                </group>
                <group>
                    <field name="year"/>
                    <field name="test_date"/>
                    <field name="macroetch"/>
                    <field name="dimensional_inspection"/>
                    <field name="visual_inspection"/>
                    <field name="three_digit_traceability"/>
                    <field name="certificate_number"/>
                    <field name="supplier_certificate"/>
                    <field name="nace_value"/>
                    <field name="po_number"/>
                </group>
            </group>

            <notebook invisible="category != 'nut'">
                <page string="NUT Physical Properties">
                    <group>
                        <table class="table table-sm o_form_table">
                            <thead>
                                <tr>
                                    <th/>
                                    <th>Requirement</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>Hardness</th>
                                    <td><field name="hardness_requirement"/></td>
                                    <td><field name="hardness_value"/></td>
                                </tr>
                                <tr>
                                    <th>Sample Nut Hardness</th>
                                    <td><field name="sample_nut_hardness_requirement"/></td>
                                    <td><field name="sample_nut_hardness_value"/></td>
                                </tr>
                                <tr>
                                    <th>Completed Nut Hardness</th>
                                    <td><field name="completed_nut_hardness_requirement"/></td>
                                    <td><field name="completed_nut_hardness_value"/></td>
                                </tr>
                                <tr>
                                    <th>Tempering</th>
                                    <td><field name="tempering_requirement"/></td>
                                    <td><field name="tempering_value"/></td>
                                </tr>
                                <tr>
                                    <th>Proof Load</th>
                                    <td><field name="proof_load_requirement"/></td>
                                    <td><field name="proof_load_value"/></td>
                                </tr>
                                <tr>
                                    <th>Heat Treatment</th>
                                    <td><field name="heat_treatment_requirement"/></td>
                                    <td><field name="heat_treatment_value"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </group>
                </page>
                <page string="NUT Chemical Analysis">
                    <group>
                        <table class="table table-sm o_form_table">
                            <thead>
                                <tr>
                                    <th/>
                                    <th>Requirement</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>Carbon (C)</th>
                                    <td><field name="carbon_requirement"/></td>
                                    <td><field name="carbon_value"/></td>
                                </tr>
                                <tr>
                                    <th>Silicon (Si)</th>
                                    <td><field name="silicon_requirement"/></td>
                                    <td><field name="silicon_value"/></td>
                                </tr>
                                <tr>
                                    <th>Manganese (Mn)</th>
                                    <td><field name="manganese_requirement"/></td>
                                    <td><field name="manganese_value"/></td>
                                </tr>
                                <tr>
                                    <th>Phosphorus (P)</th>
                                    <td><field name="phosphorus_requirement"/></td>
                                    <td><field name="phosphorus_value"/></td>
                                </tr>
                                <tr>
                                    <th>Sulfur (S)</th>
                                    <td><field name="sulfur_requirement"/></td>
                                    <td><field name="sulfur_value"/></td>
                                </tr>
                                <tr>
                                    <th>Cr %</th>
                                    <td><field name="cr_percent_requirement"/></td>
                                    <td><field name="cr_percent_value"/></td>
                                </tr>
                                <tr>
                                    <th>Mo %</th>
                                    <td><field name="mo_percent_requirement"/></td>
                                    <td><field name="mo_percent_value"/></td>
                                </tr>
                                <tr>
                                    <th>Nickel (Ni)%</th>
                                    <td><field name="nickel_requirement"/></td>
                                    <td><field name="nickel_value"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </group>
                </page>
            </notebook>

        </xpath>
        </field>
    </record>

</odoo>