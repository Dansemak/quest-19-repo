<odoo>

    <record id="mtr_nut_view_form" model="ir.ui.view">
        <field name="name">mtr.nut.view.form</field>
        <field name="model">mtr.template</field>
        <field name="inherit_id" ref="mtr_template_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//group[@name='main_info_group']" position="after">

            <group string="NUT Product Information" invisible="category != 'nut'">
                <group>
                    <field name="product_type"/>
                    <field name="dimension"/>
                    <field name="diameter"/>
                    <field name="description"/>
                    <field name="manufacturer_id"/>
                    <field name="country_of_origin"/>
                    <field name="standard"/>
                    <field name="material"/>
                    <field name="marking"/>
                    <field name="lot_batch_number"/>
                    <field name="reference"/>
                    <field name="year"/>
                    <field name="test_date"/>
                    <field name="macroetch"/>
                </group>
                <group>
                    <field name="dimensional_inspection"/>
                    <field name="visual_inspection"/>
                    <field name="three_digit_traceability"/>
                    <field name="certificate_number"/>
                    <field name="supplier_certificate"/>
                    <field name="nace_value"/>
                    <field name="po_number"/>
                </group>
            </group>

            <notebook invisible="category != 'nut'">
                <page string="NUT Physical Properties">
                    <group>
                        <group string="NUT Physical Properties Requirement">
                            <field name="hardness_requirement"/>
                            <field name="sample_nut_hardness_requirement"/>
                            <field name="completed_nut_hardness_requirement"/>
                            <field name="tempering_requirement"/>
                            <field name="proof_load_requirement"/>
                            <field name="charpy_requirement"/>
                            <field name="heat_treatment_requirement"/>
                        </group>
                        <group string="NUT Physical Properties Values">
                            <field name="hardness_value"/>
                            <field name="sample_nut_hardness_value"/>
                            <field name="completed_nut_hardness_value"/>
                            <field name="tempering_value"/>
                            <field name="proof_load_value"/>
                            <field name="charpy_value"/>
                            <field name="heat_treatment_value"/>
                        </group>
                    </group>
                </page>
                <page string="NUT Chemical Analysis">
                    <group>
                        <group string="NUT Chemical Analysis Requirements">
                            <field name="carbon_requirement"/>
                            <field name="silicon_requirement"/>
                            <field name="manganese_requirement"/>
                            <field name="phosphorus_requirement"/>
                            <field name="sulfur_requirement"/>
                            <field name="cr_percent_requirement"/>
                            <field name="mo_percent_requirement"/>
                            <field name="nickel_requirement"/>
                        </group>
                        <group string="NUT Chemical Analysis Values">
                            <field name="carbon_value"/>
                            <field name="silicon_value"/>
                            <field name="manganese_value"/>
                            <field name="phosphorus_value"/>
                            <field name="sulfur_value"/>
                            <field name="cr_percent_value"/>
                            <field name="mo_percent_value"/>
                            <field name="nickel_value"/>
                        </group>
                    </group>
                </page>
            </notebook>

        </xpath>
        </field>
    </record>

</odoo>