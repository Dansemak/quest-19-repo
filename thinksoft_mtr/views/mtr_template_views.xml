<odoo>

    <record id="mtr_template_view_list" model="ir.ui.view">
        <field name="name">mtr.template.view.list</field>
        <field name="model">mtr.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="heat_number"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="mtr_template_tree_view_search" model="ir.ui.view">
        <field name="name">mtr.template.tree.view.search</field>
        <field name="model">mtr.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="heat_number" string="Heat Number"/>
                <field name="product_id" string="Product"/>

                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>

                <searchpanel>
                    <field name="category" icon="fa-th-list" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="mtr_template_view_form" model="ir.ui.view">
        <field name="name">mtr.template.view.form</field>
        <field name="model">mtr.template</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>

                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="create_date" invisible="1"/>

                    <group name="main_info_group">
                        <group>
                            <field name="category" readonly="create_date != False"/>
                            <field name="product_id" readonly="create_date != False"/>
                            <field name="heat_number" readonly="create_date != False"/>
                        </group>
                    </group>
                    
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mtr_template_action_list" model="ir.actions.act_window">
        <field name="name">MTR</field>
        <field name="res_model">mtr.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo> 