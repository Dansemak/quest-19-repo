<odoo>

    <record id="mtr_rtj_view_form" model="ir.ui.view">
        <field name="name">mtr.rtj.view.form</field>
        <field name="model">mtr.template</field>
        <field name="inherit_id" ref="mtr_template_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//group[@name='main_info_group']" position="after">

            <group string="RTJ Product Information" invisible="category != 'rtj'">
                <group>
                    <field name="description"/>
                    <field name="material"/>
                    <field name="country_of_origin"/>
                    <field name="manufacturer_id"/>
                    <field name="standard"/>
                </group>
                <group>
                    <field name="year"/>
                    <field name="test_date"/>
                    <field name="lot_batch_number"/>
                    <field name="certificate_number"/>
                    <field name="supplier_certificate"/>
                    <field name="po_number"/>
                </group>
            </group>

            <notebook invisible="category != 'rtj'">
                <page string="RTJ Physical Properties">
                    <table class="table table-sm o_form_table">
                        <thead>
                            <tr>
                                <th/>
                                <th>Requirement</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Tensile Strength</th>
                                <td><field name="tensile_strength_requirement"/></td>
                                <td><field name="tensile_strength_value"/></td>
                            </tr>
                            <tr>
                                <th>Yield Strength</th>
                                <td><field name="yield_strength_requirement"/></td>
                                <td><field name="yield_strength_value"/></td>
                            </tr>
                            <tr>
                                <th>Elongation</th>
                                <td><field name="elongation_requirement"/></td>
                                <td><field name="elongation_value"/></td>
                            </tr>
                            <tr>
                                <th>Reduction</th>
                                <td><field name="reduction_requirement"/></td>
                                <td><field name="reduction_value"/></td>
                            </tr>
                            <tr>
                                <th>Hardness</th>
                                <td><field name="hardness_requirement"/></td>
                                <td><field name="hardness_value"/></td>
                            </tr>
                            <tr>
                                <th>Heat Treatment</th>
                                <td><field name="heat_treatment_requirement"/></td>
                                <td><field name="heat_treatment_value"/></td>
                            </tr>
                        </tbody>
                    </table>
                </page>
                <page string="RTJ Chemical Analysis">
                    <table class="table table-sm o_form_table">
                        <thead>
                            <tr>
                                <th/>
                                <th>Requirement</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Carbon (C)%</th>
                                <td><field name="carbon_requirement"/></td>
                                <td><field name="carbon_value"/></td>
                            </tr>
                            <tr>
                                <th>Silicon (Si)%</th>
                                <td><field name="silicon_requirement"/></td>
                                <td><field name="silicon_value"/></td>
                            </tr>
                            <tr>
                                <th>Manganese (Mn)%</th>
                                <td><field name="manganese_requirement"/></td>
                                <td><field name="manganese_value"/></td>
                            </tr>
                            <tr>
                                <th>Phosphorus (P)%</th>
                                <td><field name="phosphorus_requirement"/></td>
                                <td><field name="phosphorus_value"/></td>
                            </tr>
                            <tr>
                                <th>Sulfur (S)%</th>
                                <td><field name="sulfur_requirement"/></td>
                                <td><field name="sulfur_value"/></td>
                            </tr>
                            <tr>
                                <th>Chromium (Cr)%</th>
                                <td><field name="chromium_requirement"/></td>
                                <td><field name="chromium_value"/></td>
                            </tr>
                            <tr>
                                <th>Molybdenum (Mo)%</th>
                                <td><field name="molybdenum_requirement"/></td>
                                <td><field name="molybdenum_value"/></td>
                            </tr>
                            <tr>
                                <th>Nickel (Ni)%</th>
                                <td><field name="nickel_requirement"/></td>
                                <td><field name="nickel_value"/></td>
                            </tr>
                            <tr>
                                <th>Nitrogen (N)%</th>
                                <td><field name="nitrogen_requirement"/></td>
                                <td><field name="nitrogen_value"/></td>
                            </tr>
                            <tr>
                                <th>Titanium (Ti)%</th>
                                <td><field name="titanium_requirement"/></td>
                                <td><field name="titanium_value"/></td>
                            </tr>
                            <tr>
                                <th>Iron (Fe)%</th>
                                <td><field name="iron_requirement"/></td>
                                <td><field name="iron_value"/></td>
                            </tr>
                            <tr>
                                <th>Aluminium (Al)%</th>
                                <td><field name="aluminium_requirement"/></td>
                                <td><field name="aluminium_value"/></td>
                            </tr>
                            <tr>
                                <th>Copper (Cu)%</th>
                                <td><field name="copper_requirement"/></td>
                                <td><field name="copper_value"/></td>
                            </tr>
                        </tbody>
                    </table>
                </page>
            </notebook>

        </xpath>
        </field>
    </record>

</odoo>