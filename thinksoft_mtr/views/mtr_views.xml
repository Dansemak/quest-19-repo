<odoo>

    <record id="mtr_template_view_list" model="ir.ui.view">
        <field name="name">mtr.template.view.list</field>
        <field name="model">mtr.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="mtr_template_view_form" model="ir.ui.view">
        <field name="name">mtr.template.view.form</field>
        <field name="model">mtr.template</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="active" invisible="1"/>

                    <group>
                        <group>
                            <field name="category"/>
                        </group>
                    </group>

                    <!-- ================== BAR and STUD fields ================== -->
                    <group string="BAR/STUD Product Information">
                        <group>
                            <field name="heat_number"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="dimension"/>
                            <field name="diameter"/>
                            <field name="length"/>
                            <field name="product_type"/>
                            <field name="country_of_origin"/>
                            <field name="manufacturer_id"/>
                            <field name="standard"/>
                            <field name="material"/>
                            <field name="marking"/>
                            <field name="lot_batch_number"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="test_date"/>
                            <field name="certificate_number"/>
                            <field name="supplier_certificate"/>
                            <field name="macroetch"/>
                            <field name="dimensional_inspection"/>
                            <field name="visual_inspection"/>
                            <field name="nace_value"/>
                            <field name="three_digit_traceability"/>
                            <field name="po_number"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ================== BAR and STUD fields ================== -->
                        <page string="BAR/STUD Physical Properties" name="bar_stud_physical_properties" invisible="category not in ('bar', 'stud')">
                            <group name="bar_stud_physical_properties_group">
                                <group name="physical_properties_requirements_group" string="BAR/STUD Physical Properties Requirement">
                                    <field name="tensile_strength_requirement"/>
                                    <field name="yield_strength_requirement"/>
                                    <field name="elongation_requirement"/>
                                    <field name="reduction_requirement"/>
                                    <field name="tempering_requirement"/>
                                    <field name="quenching_requirement"/>
                                    <field name="charpy_requirement"/>
                                    <field name="hardness_requirement"/>
                                    <field name="heat_treatment_requirement"/>
                                </group>
                                <group name="bar_stud_physical_properties_values_group" string="BAR/STUD Physical Properties Values">
                                    <field name="tensile_strength_value"/>
                                    <field name="yield_strength_value"/>
                                    <field name="elongation_value"/>
                                    <field name="reduction_value"/>
                                    <field name="tempering_value"/>
                                    <field name="quenching_value"/>
                                    <field name="charpy_value"/>
                                    <field name="hardness_value"/>
                                    <field name="heat_treatment_value"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="mtr_template_action_list" model="ir.actions.act_window">
        <field name="name">MTR</field>
        <field name="res_model">mtr.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo> 