<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_thinksoft_mtr" model="ir.ui.view">
        <field name="name">stock.picking.form.thinksoft.mtr</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='lot_ids']" position="after">
                <field name="mtr_template_ids" widget="many2many_tags" options="{'no_create': True}" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
