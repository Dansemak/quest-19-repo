<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_thinksoft_mtr" model="ir.ui.view">
        <field name="name">stock.picking.form.thinksoft.mtr</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='extra']" position="after">
                <page string="MTRs" name="mtr">
                    <button string="Print MTR Top Sheet" name="action_print_mtr_order_details" type="object" class="float-end"/>
                    <button string="Print All MTRs" name="action_print_all_mtrs" type="object" class="oe_highlight float-end"/>
                    <field name="mtr_move_ids">
                        <list create="false" delete="false" editable="bottom">
                            <field name="product_id" readonly="1"/>
                            <field name="created_production_id" string="MO #" readonly="1"/>
                            <field name="mtr_template_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <button string="Pull from MO" name="button_pull_from_mo" type="object" class="oe_highlight"/>
                            <button string="MTRs" name="action_print_mtrs" type="object" class="oe_highlight"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
