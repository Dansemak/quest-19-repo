<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mtr_external_layout">            
        <div class="header row">
        <style>
                @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&amp;family=Sansation:wght@700&amp;display=swap');
                .header,.footer {
                      font-family: 'Roboto Condensed','Sansation',  sans-serif ;
                    }
            </style>
            <div class="col-4">
                <img src="/thinksoft_mtr/static/img/quest-logo.jpg" style="width:200px;"/>
            </div>
            <div class="col-6 text-center">
                <div style="font-size:20px;">CERTIFICATE OF TEST</div>
                <div style="font-size:14px;">(ACCORDING TO EN 10204 3.1)</div>
            </div>
        </div>
        <div class="article">
            <t t-raw="0"/>
        </div>
        <div class="footer container" style="font-size:11px;">
            <span>Print Date:</span>
            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y %H:%M:%S')"/>
            <span style="margin-left:200px;">www.questgasket.com</span>
            <div style="float:right;">Page: <span class="page"/> of <span class="topage"/></div>
        </div>
    </template>
    
    <template id="mtr_base_template">
        <t t-foreach="docs" t-as="o">
            <t t-if="o.category in ('bar', 'stud')">
                <t t-call="thinksoft_mtr.bar_stud_mtr_document"/>
            </t>
            <t t-if="o.category == 'nut'">
                <t t-call="thinksoft_mtr.nut_mtr_document"/>
            </t>
            <t t-if="o.category == 'rtj'">
                <t t-call="thinksoft_mtr.rtj_mtr_document"/>
            </t>
        </t>
    </template>

</odoo>