<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_no_create" model="ir.ui.view">
        <field name="name">purchase.order.form.no.create</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="/form/sheet/group/group/field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form/sheet/group/group/field[@name='currency_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form/sheet/notebook/page[@name='products']/field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form//field[@name='project_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form//field[@name='incoterm_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

        </field>
    </record>

</odoo>