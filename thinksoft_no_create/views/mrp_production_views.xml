<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="mrp_production_form_view_no_create" model="ir.ui.view">
            <field name="name">mrp.production.form.no.create</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="/form/sheet/group/group/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form//field[@name='bom_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form//field[@name='user_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list//field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form/sheet/notebook/page[@name='miscellaneous']/group/group/field[@name='picking_type_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form//field[@name='project_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>