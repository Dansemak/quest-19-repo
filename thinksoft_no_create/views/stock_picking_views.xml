<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_no_create" model="ir.ui.view">
        <field name="name">stock.picking.form.no.create</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="/form/sheet/group/group/field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form/sheet/group/group/field[@name='picking_type_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form//field[@name='sale_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form//field[@name='user_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="/form//field[@name='project_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

        </field>
    </record>

</odoo>