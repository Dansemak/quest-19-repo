<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="mrp_bom_form_view_no_create" model="ir.ui.view">
            <field name="name">mrp.bom.form.no.create</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="/form/sheet/group/group/field[@name='product_tmpl_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form//field[@name='picking_type_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

                <xpath expr="/form//field[@name='project_id']" position="attributes">
                    <attribute name="options">{'no_create':True}</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>