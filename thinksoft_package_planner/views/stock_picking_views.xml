<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_package" model="ir.ui.view">
        <field name="name">product.package</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
        <xpath expr="//page[@name='extra']" position="after">
            <page string="Package">
                <button name="button_create_packages" type="object" string="Update Package" class="oe_highlight"/>
                <button name="button_skid_label" type="object" string="Print Skid Labels" class="oe_right"/>
                <button name="button_box_label" type="object" string="Print Box Labels" class="oe_right"/>
                <field name="package_plan_ids">
                    <list>
                        <field name="seq"/>
                        <field name="product_id"/>
                        <field name="description"/>
                        <field name="tagging"/>
                        <field name="mtr_template_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                        <field name="max_qty_pack"/>
                        <field name="pick_qty"/>
                        <field name="qty_packed"/>
                        <field name="in_box"/>
                        <field name="box_qty"/>
                        <field name="skid_qty"/>
                        <button name="button_package_label_3x4" string="3x4" type="object" invisible="1"/>
                        <button name="button_package_label_1_25x4" string="1.25x4" type="object"/>
                    </list>
                     <form string="Package Plan">   
                           <group>
                               <group>
                                   <field name="product_id"/>
                                   <field name="pick_qty" readonly="True"/>
                                   <field name="in_box" invisible="1"/>
                                   <field name="qty_packed" invisible="1"/>
                                   <field name="last_box_no" invisible="1"/>
                               </group>
                               <group>
                                <field name="seq" invisible="1"/>
                                   <field name="box_qty" invisible="1"/>
                                   <field name="skid_qty" invisible="1"/>
                                   <field name="last_box_no"/>
                                   <field name="pack_type"/>
                                   <field name="max_qty_pack"/>
                                   <field name="is_skid"/>
                                   <field name="skid_number"/>
                                   <field name="mtr_template_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                                   <button name="load_lines" type="object" string="Calculate" class="oe_highlight" />
                               </group>
                           </group>
                            <field name="package_plan_line_ids" nolabel="1">
                               <list string="Package Planning Details" editable="bottom">
                                   <field name="seq_no"/>
                                   <field name="package_type"/>
                                   <field name="in_box"/>
                                   <field name="qty_packed" sum="Total Quantity Packed"/>
                                   <field name="is_skid"/>
                                   <field name="skid_number"/>
                                   <field name="available_mtr_template_ids" widget="many2many_tags" invisible="1"/>
                                   <field name="mtr_template_ids" widget="many2many_tags" domain="[('id', 'in', available_mtr_template_ids)]" options="{'no_create': True}"/>
                               </list>
                           </field>
                           <button name="save_load" string="Update Package" type="object" class="oe_highlight"/>
                       </form>
                  </field>
            </page>
        </xpath>
        </field>
    </record>
</odoo>
