<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="paperformat_1_25x4" model="report.paperformat">
		<field name="name">1_25x4 Paper Format</field>
		<field name="default" eval="True"/>
		<field name="format">custom</field>
		<field name="page_height">31</field>
		<field name="page_width">100</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">3</field>
		<field name="margin_bottom">5</field>
		<field name="margin_left">0</field>
		<field name="margin_right">0</field>
		<field name="header_line" eval="False"/>
		<field name="header_spacing">37</field>
		<field name="dpi">80</field>
	</record>

	<record id="1_25x4_label_report" model="ir.actions.report">
		<field name="name">1_25x4 Report</field>
		<field name="model">package.plan</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">thinksoft_package_planner.1_25x4_report</field>
		<field name="report_file">thinksoft_package_planner.1_25x4_report</field>
		<field name="paperformat_id" ref="thinksoft_package_planner.paperformat_1_25x4"/>
		<field name="binding_model_id" ref="model_package_plan"/>
		<field name="binding_type">report</field>
	</record>

	<template id="1_25x4_report">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="doc">
				<t t-call="thinksoft_package_planner.1_25x4_report_doc" />
			</t>
		</t>
	</template>

	<template id="internal_layout">
		<!-- Multicompany -->
		<t t-if="o and 'company_id' in o">
			<t t-set="company" t-value="o.company_id" />
		</t>
		<t t-if="not o or not 'company_id' in o">
			<t t-set="company" t-value="res_company" />
		</t>
		<div class="header">
			<div class="row">
			</div>
		</div>
		<div class="article">
			<t t-raw="0" />
		</div>
		<div class="footer">
            <div class="container ">
                <div class="row">
                <div class="col-12" style=" text-align: center; font-family:sans-serif;font-size: 9px;">www.questgasket.com</div>
                </div>
            </div>
        </div>
	</template>

	<template id="1_25x4_report_doc">
		<t t-call="thinksoft_package_planner.internal_layout">
			<div class="page">
				<div class="oe_structure">
					<div class="container" style="margin:0 !important;">
						<div class="row">
							<div class="col-9" style="font-size:10px;">
								<span style="font-weight:bold;">Item Code:</span>
								<span class="ml-2" style="font-weight:normal;" t-field="doc.product_id.name" />
								<br />
								<span style="font-weight:bold;">Item Description:</span>
								<span style="font-weight:normal; " t-field="doc.description" />
							</div>
							<div class="col-3" style="margin-top:-5px;">
								<img
									t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc.product_id.name, 150, 150)"
									style="width:75px;height:75px" />
							</div>
						</div>
						<div class="row">
							<div class="col-9" style="font-size:9px;">
								<span style="font-weight:bold;">S.O: </span><span class="ml-2" t-field="doc.picking_id.origin" />
							</div>
							 <div class="col-3" style="font-size:9px; margin-left:10px;"><span style="font-weight:bold;">Qty: </span><span
                                    class="ml-2" style="font-weight:normal;"
                                    t-field="doc.max_qty_pack" />
                            </div>
						</div>
					</div>
				</div>
			</div>
		</t>
	</template>

</odoo>