<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_1_25x4" model="report.paperformat">
        <field name="name">1_25x4 Paper Format</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">31</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">37</field>
        <field name="dpi">80</field>
    </record>

    <record id="1_25x4_label_report" model="ir.actions.report">
        <field name="name">1_25x4 Report</field>
        <field name="model">package.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">thinksoft_package_planner.1_25x4_report</field>
        <field name="report_file">thinksoft_package_planner.1_25x4_report</field>
        <field name="paperformat_id" ref="thinksoft_package_planner.paperformat_1_25x4" />
        <field name="binding_model_id" ref="model_package_plan" />
        <field name="binding_type">report</field>
    </record>

    <template id="1_25x4_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="thinksoft_package_planner.1_25x4_report_doc" />
            </t>
        </t>
    </template>

    <template id="internal_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="header">
            <div class="row">
            </div>
        </div>
        <div class="article">
            <t t-raw="0" />
        </div>
        <div class="footer">
            <div class="container ">
                <div class="row">
                    <div class="col-12" style=" text-align: center; font-family:sans-serif;font-size: 9px;">www.questgasket.com</div>
                </div>
            </div>
        </div>
    </template>

    <template id="1_25x4_report_doc">
        <t t-call="thinksoft_package_planner.internal_layout">
            <style>
				.page {
						font-family: Arial, Helvetica, sans-serif;
					}
            </style>
            <div class="page">
                <div class="oe_structure">
                    <div class="row">
                    <!-- ********** Item code ********** -->
                        <div class="col-9" style="font-size:11px;">
                            <span style="font-weight:bold;">Item Code:</span>
                            <span class="ml-2" style="font-weight:normal;" t-field="doc.product_id.name" />
                            <br />
                            <!-- ********** Description ********** -->
                            <span style="font-weight:bold;">Item Description:</span>
                            <span style="font-weight:normal; " t-field="doc.description" />
                        </div>
                        <!-- ********** QRcode ********** -->
                        <div class="col-3" style="text-align:right;">
                            <img t-if="doc.product_id" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=100&amp;height=100'
										% (doc.product_id.name)" style="width:50px;height:50px" />
                        </div>
                    </div>
                    <t t-if="doc.tagging">
                    <div class="row">
                     <!-- ********** TAGGING ********** -->
                        <div class="col-12">
                            <!-- <div> -->
                                <span class="" style="font-weight:bold; font-size:11px;">Tagging:</span>
                                <span class="ms-2" style="font-weight:normal;font-size:11px;" t-field="doc.tagging" />
                            <!-- </div> -->
                        </div>
                    </div>
                    </t>
                    <div class="row" style="">
                    <!-- ********** SO ********** -->
                        <div class="col-9" style="font-size:11px;">
                            <span style="font-weight:bold;">S.O:</span>
                            <span class="ml-2" t-field="doc.picking_id.origin" />
                        </div>
                        <!-- ********** QTY ********** -->
                        <div class="col-3" style="font-size:11px; ">
                            <span style="font-weight:bold;">Qty: </span>
                            <span class="ml-2" style="font-weight:normal;" t-field="doc.max_qty_pack" />
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>