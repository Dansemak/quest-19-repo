<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="paperformat_package_label" model="report.paperformat">
            <field name="name">Package Label Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">203</field>
            <field name="page_width">102</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">6</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">80</field>
        </record>


        <record id="box_label_report" model="ir.actions.report">
            <field name="name">Box Label</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thinksoft_package_planner.box_label_template</field>
            <field name="report_file">thinksoft_package_planner.box_label_template</field>
            <field name="paperformat_id" ref="thinksoft_package_planner.paperformat_package_label"/>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <record id="box_skid_qweb_report" model="ir.actions.report">
            <field name="name">Skid Labels</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thinksoft_package_planner.box_skid_qweb_template</field>
            <field name="report_file">thinksoft_package_planner.box_skid_qweb_template</field>
            <field name="paperformat_id" ref="thinksoft_package_planner.paperformat_package_label"/>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>
</odoo>
