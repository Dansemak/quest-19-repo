<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_3x4" model="report.paperformat">
        <field name="name">3x4 Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">70</field>
        <field name="page_width">95</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">80</field>
    </record>

    <record id="3x4_label_report" model="ir.actions.report">
        <field name="name">3x4 Report</field>
        <field name="model">package.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">thinksoft_package_planner.label_3x4_template</field>
        <field name="report_file">thinksoft_package_planner.label_3x4_template</field>
        <field name="paperformat_id" ref="thinksoft_package_planner.paperformat_3x4"/>
        <field name="binding_model_id" ref="model_package_plan"/>
        <field name="binding_type">report</field>
    </record>

     <template id="label_3x4_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_package_planner.3x4_report_document" t-lang="doc.partner_id.lang"/>
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_package_planner.3x4_report_document"/>
                </t>
            </t>
        </t>
    </template>
    <template id="internal_layout">
    <!-- <template id="internal_layout_label_3x4"> -->
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="header">
            <div class="row">
            </div>
        </div>
        <div class="article">
            <t t-raw="0" />
        </div>
        <div class="footer">
            <div class="container ">
                <div class="row">
                <div class="col-12" style=" text-align: center; font-family:sans-serif;font-size: 10px;">www.questgasket.com</div> 
                </div>
            </div>
        </div>
    </template>
    <template id="3x4_report_document">
        <t t-call="thinksoft_package_planner.internal_layout">
            <style>
                .page {
                    font-family: Arial, Helvetica, sans-serif;
                }
            </style>
            <div class="page">
                     <div class="row">
                        <div class="col-12">
                            <img class="img" style="width:180px; display:block; margin-left:auto; margin-right:auto;"  src="/thinksoft_package_planner/static/src/img/quest-logo.jpg"  />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 mt-2 " style="">
                            <span style="font-size:12px; font-weight:bold;">Item Code:</span>
                            <span class="ml-2" style="font-size:14px;font-weight:normal;"
                                t-field="doc.product_id.name" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 " style="">
                            <div style="font-size:12px;font-weight:bold;">Item Description:
                                <span class="ml-2" style="font-size:11px; font-weight:normal; line-height:0.8 !important;" t-field="doc.description" />     
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12" style="">
                            <p style="font-size:12px; margin-bottom:14px; font-weight:bold;">Heat #: <span
                                    class="ml-2" style="font-size:14px; font-weight:normal;"
                                    t-field="doc.mtr_template_ids.heat_number"/>
                            </p>
                        </div> 
                    </div>
                    <div class="row">
                        <div class="col-6" style="">
                            <div class="">
                                <span style="font-weight:bold; font-size:12px;">SO: </span><span class="ml-2" t-field="doc.picking_id.origin" style="font-size:14px; font-weight:normal;"/>		
                            </div>
                        </div>
                       
                        <div class="col-6 " style="">
                            <!-- <t t-if="doc.stock_move_id.created_production_id"> -->
                                <span style="font-weight:bold; font-size:12px;">MO: </span>
                                <span class="ms-2" t-field="doc.stock_move_id.created_production_id" style="font-size:14px; font-weight:normal;"/>		
                            <!-- </t>  -->
                        </div>       
                    </div> 
                    <t t-if="doc.tagging">
                    <div class="row mt-2">
                     <!-- ********** TAGGING ********** -->
                    
                        <div class="col-8">
                            <!-- <div> -->
                                <span class="" style="font-weight:bold; font-size:12px;">Tagging:</span>
                                <span class="ms-2" style="color:#43464f; font-weight:normal;font-size:14px;" t-field="doc.tagging" />
                            <!-- </div> -->
                        </div>
                        <div class="col-4 " style="">
                            <span style="font-weight:bold; font-size:12px;">Qty:</span> 
                            <span class="ms-2"  t-field="doc.max_qty_pack" style="font-size:14px; font-weight:normal;"/>
                        </div>
                    </div>
                    </t>
                    <!-- <div class="row">
                        <div class="col-6 text-center" style="">
                            <span style="font-weight:bold; font-size:12px;">Qty:</span> 
                            <span class="ms-2"  t-field="doc.max_qty_pack" style="font-size:14px; font-weight:normal;"/>
                        </div>
                        
                    </div>  -->

            </div>
        </t>
    </template>

</odoo>