<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<template id="box_label_internal_layout">
		<!-- Multicompany -->
		<t t-if="o and 'company_id' in o">
			<t t-set="company" t-value="o.company_id"/>
		</t>
		<t t-if="not o or not 'company_id' in o">
			<t t-set="company" t-value="res_company"/>
		</t>
		<div class="header">
			<div class="row"/>
		</div>
		<div class="article">
			<t t-raw="0"/>
		</div>
	</template>

	<template id="box_labels_qweb_template">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="doc">
				<t t-call="thinksoft_package_planner.box_label_internal_layout">
					<t t-foreach="get_boxes" t-as="box">
						<div class="page">
							<style>
								.col-4, .col-2, .col-3, .col-6, .col-5, .col-12, .col-8, .col-10, table {
									padding: 0 !important;
									margin: 0 !important;
								}
								.container, .row {
									padding-left: 0 !important;
									padding-right: 0 !important;
									margin-left: 0 !important;
									margin-right: 0 !important;
								}
							</style>
							<div class="container">
								<div class="row mb-3">
									<div class="col-4">
										<img style="float:left; width: 200px; margin-right:50px;"
											src="/thinksoft_package_planner/static/src/img/quest-logo.jpg" />
									</div>
									<div class="col-2"/>
									<div class="col-6"
										style="text-align:right;font-size:33px;font-weight:bold;font-family:Arial; font-weight:bold;text-margin:right;">
										<h2>BOX <span t-esc="box['box']"/></h2>
									</div>
								</div>
								<div class="row mb-2">
									<div class="col-10" style="font-size:12px;font-family:Arial;">
										<span t-field="doc.company_id.street2"/> , <span t-field="doc.company_id.city"/>, <span t-field="doc.company_id.zip"/>
									</div>
								</div>
								<div class="row mb-2">
									<div class="col-12 text-uppercase" style="font-size:12px;font-family:Arial;">
										<strong>CUSTOMER:</strong>
										<span t-esc="doc.sale_partner_id.name"/>
									</div>
								</div>
								<div class="row mb-2">
									<div class="col-12 text-uppercase" style="font-size:12px;font-family:Arial;">
										<strong>
											<span >SHIP TO:</span>
										</strong>
										<!-- <div style="font-size:12;font-family:Arial;"
										t-esc="doc['partner_id']['name']"></div>
						<div style="font-size:12;font-family:Arial;" t-esc="doc['partner_id']['street2']"></div>
						<div style="font-size:12;font-family:Arial;" t-esc="doc['partner_id']['city']"></div> -->
										<div groups="sale.group_delivery_invoice_address">
											<div t-field="doc.partner_id"
												t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" />
										</div>
									</div>
								</div>
								<div class="row text-uppercase" style="font-size:14px;font-family:Arial;">
									<div class="col-6">
										<span>PO #</span>
										<strong>
											<span t-esc="doc['client_order_ref']" />
										</strong>
									</div>
									<div class="col-6 pl-2">
										<span>SO #</span>
										<strong>
											<span t-esc="doc['origin']"/>
										</strong>
									</div>
								</div>
								<div class="row text-uppercase" style="font-size:14px;font-family:Arial;">
									<div class="col-12">
										<span>SHIP VIA:</span>
										<strong>
											<span t-esc="doc['sale_ship_via']['name']"/>
										</strong>
									</div>
								</div>
								
								<div class="row mt-2 mb-3"
									style="width:100%;border-top: 1px dashed #000;" />
								<div class="row mt-2">
									<table style="font-size:12px;font-family:Arial;width:100%;">
										<thead>
											<tr>
												<th style="padding:4px;width:10%;">LINE</th>
												<th style="padding:4px;width:70%;">PART DESCRIPTION</th>
												<th style="padding:4px;width:20%;">QTY/of</th>
											</tr>
										</thead>
										<tbody>
											<t t-foreach="get_box_label" t-as="p">
												<t t-if="str(box['box']) in p">
													<tr>
														<t t-set="b_value" t-value="p[str(box['box'])][0]"/>
														<td style="padding:4px;">
															<t t-esc="b_value['seq_no']"/>
														</td>
														<td style="padding:4px;">
															<strong style="font-size:14px;"><t t-esc="b_value['name']"/></strong>
															<br/>
															<t t-esc="b_value['desc']"/>
															<t t-if="b_value['heat']">
																<span style="display:block;font-size:14px;">
																	HEAT#: <strong><t t-esc="b_value['heat']"/></strong>
																</span>
															</t>
															<t t-if="b_value['tagging']">
																<span style="display:block;font-size:14px;">
																	TAG: <strong><t t-esc="b_value['tagging']"/></strong>
																</span>
															</t>
														</td>
														<td style="padding:4px;">
															<t t-esc="b_value['qty']"/> / 
															<t t-esc="b_value['pick_qty']"/>
														</td>
													</tr>
												</t>
											</t>
										</tbody>
									</table>
								</div>
							</div>
							<p style="page-break-after:always;" />

						</div>
					</t>
				</t>
			</t>
		</t>
	</template>

</odoo>