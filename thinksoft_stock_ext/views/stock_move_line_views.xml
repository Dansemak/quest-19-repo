<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_tree_detailed_inherit_stock" model="ir.ui.view">
        <field name="name">stock.move.line.view.tree.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id']" position="before">
                <field name="seq_no" />
                <field name="available_locations_ids" optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>
