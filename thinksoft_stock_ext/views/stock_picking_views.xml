<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_thinksoft_stock_ext" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">

            <!-- adding the Customer before the contact field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_customer_id" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" options="{'no_create': True}" />
            </xpath>

            <!-- renaming shipping label-->
            <xpath expr="//group[@name='carrier_data']//label[@for='shipping_weight']" position="attributes">
                <attribute name="string">Shipping Weight</attribute>
            </xpath>

            <!-- adding the Picker, Packer, Shipper, and Team to Header -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="waybill" invisible="picking_type_sequence_code != 'OUT'" />
                <field name="team_responsible" invisible="picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
                <field name="picker_id" invisible="picking_type_sequence_code != 'PICK'" options="{'no_create': True}" />
                <field name="packer_id" invisible="picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" options="{'no_create': True}" />
                <field name="shipper_id" invisible="picking_type_sequence_code != 'OUT'" options="{'no_create': True}" />

                <!-- moving the shipping_weight and label to the header -->
                <xpath expr="//group[@name='carrier_data']//label[@for='shipping_weight']" position="move"/>
                <xpath expr="//group[@name='carrier_data']//div[3]" position="move"/>

                <!-- adding the box_qty and skid_qty to serve as the No Pieces -->
                <label for="box_qty" string="Number of Pieces" invisible="picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']"/>
                <div invisible="picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']">
                    <field name="box_qty" nolabel="1" class="oe_inline"/>
                    <span>boxes</span>
                    <br/>
                    <field name="skid_qty" nolabel="1" class="oe_inline"/>
                    <span>skids</span>
                </div>
            </xpath>

            <!-- adding the CUstomer Reference and the Salesperson to the "Additional Info" tab-->
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="salesperson_id" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
                <field name="client_order_ref" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
            </xpath>

            <!-- adding the stock.move fields to the list -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="before">
                <field name="seq_no" />
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom']" position="after">
                <field name="country_of_origin" optional="show" />
                <field name="hs_code" optional="show" />
            </xpath>

        </field>
    </record>

    <record id="vpicktree_inherit_thinksoft_stock_ext" model="ir.ui.view">
        <field name="name">stock.picking.view.list.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="team_responsible" optional="show" column_invisible="context.get('restricted_picking_type_code') not in ('outgoing', 'internal')"/>
                <field name="picker_id" optional="show" column_invisible="context.get('restricted_picking_type_code') != 'internal'"/>
                <field name="shipper_id" optional="show" column_invisible="context.get('restricted_picking_type_code') != 'outgoing'"/>
            </xpath>

        </field>
    </record>

    <record id="view_picking_internal_search_inherit_thinksoft_stock_ext" model="ir.ui.view">
        <field name="name">stock.picking.view.search.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <field name="team_responsible" invisible="context.get('restricted_picking_type_code') not in ('outgoing', 'internal')"/>
                <field name="picker_id" invisible="context.get('restricted_picking_type_code') != 'internal'"/>
                <field name="shipper_id" invisible="context.get('restricted_picking_type_code') != 'outgoing'"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string='Team' name="team_responsible" domain="[]" context="{'group_by' : 'team_responsible'}" invisible="context.get('restricted_picking_type_code') not in ('outgoing', 'internal')"/>
                <filter string='Picker' name="picker" domain="[]" context="{'group_by' : 'picker_id'}" invisible="context.get('restricted_picking_type_code') != 'internal'"/>
                <filter string='Shipper' name="shipper" domain="[]" context="{'group_by' : 'shipper_id'}" invisible="context.get('restricted_picking_type_code') != 'outgoing'"/>
            </xpath>

        </field>
    </record>

</odoo>