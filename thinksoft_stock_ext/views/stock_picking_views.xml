<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_thinksoft_stock_ext" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">

            <!-- adding the Customer before the contact field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_customer_id" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
            </xpath>

            <!-- hidding the shipping_weight field from the tab so it can be added to the header -->
            <xpath expr="//group[@name='carrier_data']//label[@for='shipping_weight']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//group[@name='carrier_data']//div[3]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- adding the Picker, Packer, Shipper, and Team to Header -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="waybill" invisible="picking_type_sequence_code != 'OUT'" />
                <field name="team_responsible" invisible="picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
                <field name="picker_id" invisible="picking_type_sequence_code != 'PICK'" />
                <field name="packer_id" invisible="picking_type_sequence_code != 'PACK'" />
                <field name="shipper_id" invisible="picking_type_sequence_code != 'OUT'" />
                <label for="shipping_weight" string="Shipping Weight"/>
                <div>
                    <field name="shipping_weight" class="oe_inline"/>
                    <field name="weight_uom_name" nolabel="1" class="oe_inline" style="margin-left:5px"/>
                </div>
                <field name="no_pieces" invisible="picking_type_sequence_code not in ['PACK', 'OUT']" placeholder="Number of boxes and skids (do not include weight)" />
            </xpath>

            <!-- adding the CUstomer Reference and the Salesperson to the "Additional Info" tab-->
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="salesperson_id" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
                <field name="client_order_ref" invisible="not sale_id and picking_type_sequence_code not in ['PICK', 'PACK', 'OUT']" />
            </xpath>

            <!-- adding the stock.move fields to the list -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="before">
                <field name="seq_no" />
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom']" position="after">
                <field name="country_of_origin" optional="show" />
                <field name="hs_code" optional="show" />
            </xpath>

        </field>
    </record>

</odoo>