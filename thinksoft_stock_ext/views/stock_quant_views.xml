<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_tree_inventory_editable_inherit_thinksoft_stock_ext" model="ir.ui.view">
        <field name="name">stock.quant.view.list.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='inventory_diff_quantity']" position="after">
                <field name="reserved_quantity" readonly="True" optional="show" string="Reserved"/>
            </xpath>

        </field>
    </record>

</odoo>
