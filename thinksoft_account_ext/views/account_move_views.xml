<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_thinksoft_account_ext" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- hiding the original ref field + label -->
            <xpath expr="//group[@name='sale_info_group']//label[@for='ref']" position="attributes">
                <attribute name="string">Customer Reference</attribute>
                <attribute name="invisible">move_type not in ['out_invoice', 'out_refund', 'out_receipt']</attribute>
            </xpath>

            <xpath expr="//group[@name='sale_info_group']//field[@name='ref']" position="attributes">
                <attribute name="invisible">move_type not in ['out_invoice', 'out_refund', 'out_receipt']</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <xpath expr="//group[@name='sale_info_group']//label[@for='ref']" position="move"/>
                <xpath expr="//group[@name='sale_info_group']//field[@name='ref']" position="move"/>
                <field name="waybill" invisible="move_type not in ['out_invoice', 'out_refund', 'out_receipt']"/>
            </xpath>

        </field>
    </record>

</odoo>
