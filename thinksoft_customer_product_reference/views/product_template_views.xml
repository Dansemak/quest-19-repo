<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="product_template_cmr" model="ir.ui.view">
        <field name="name">product.template.cmr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="/form[@name='Product Template']//page[@name='invoicing']" position="after">
                    <page string="CMR" name="product_template_cmr">
                        <field name="customer_material_reference">
                            <list default_order="id desc">
                                <field name="partner_id" />
                                <field name="customer_product_code" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

