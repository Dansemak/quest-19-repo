<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="po_generator_form" model="ir.ui.view">
            <field name="name">PO Generator Form</field>
            <field name="model">po.generator</field>
            <field name="arch" type="xml">
                <form string="Request Procurements">
                    <group name="main" col="3">
                        <field name="cost_select"/>
                        <button name="update_cost" string="Apply Cost Method" class="oe_highlight" type="object"/>
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids" nolabel="1" colspan="6">
                                <list editable="bottom" create="false">
                                    <field name="vendor_ids" widget="many2many_tags"/>
                                    <field name="vendor_id" required="1"/>
                                    <field name="product_id" required="1"/>
                                    <field name="procurement_qty"/>
                                    <field name="cost_select"/>
                                    <field name="cost_price"/>
                                    <field name="uom_id"/>
                                    <!-- <field name="warehouse_id"/> -->
                                    <field name="date_planned"/>
                                    <field name="location_id" invisible="1"/>
                                    <field name="picking_type_id" domain="[('code', '=', 'incoming')]" required="1"/>
                                    <field name="purchase_id"
                                           domain="[('partner_id', '=', vendor_id),('state','not in', ('done','cancel')),('picking_type_id', '=', picking_type_id)]"/>
                                    <field name="qty_available"/>
                                    <field name="outgoing_qty"/>
                                    <field name="incoming_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button type="object" name="validate"
                                string="Validate" class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="procurement_batch_generator_list_action" model="ir.actions.act_window">
            <field name="name">Request Procurements</field>
            <field name="res_model">procurement.batch.generator</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="thinksoft_batch_procurement.procurement_batch_generator_form"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="thinksoft_purchase_review.model_purchase_review_report"/>
            <field name="binding_view_types">list</field>
        </record>

    </data>
</odoo>
