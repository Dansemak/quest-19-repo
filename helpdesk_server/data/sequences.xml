<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ticket_helpdesk" model="ir.sequence">
            <field name="name">Helpdesk Ticket</field>
            <field name="code">ticket.helpdesk</field>
            <field name="prefix">TICK-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Change this value in Settings > Technical > System Parameters -->
        <record id="param_jwt_secret" model="ir.config_parameter">
            <field name="key">helpdesk.jwt_secret_key</field>
            <field name="value">CHANGE-THIS-SECRET-IN-PRODUCTION</field>
        </record>
    </data>
</odoo>
