<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_check_expiring_subscriptions" model="ir.cron">
            <field name="name">Helpdesk: Notify expiring subscriptions</field>
            <field name="model_id" ref="model_client_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active" eval="True"/>
        </record>

        <record id="cron_cleanup_expired_tokens" model="ir.cron">
            <field name="name">Helpdesk: Clean up expired OAuth tokens</field>
            <field name="model_id" ref="model_oauth_token"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired_tokens(days=7)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
