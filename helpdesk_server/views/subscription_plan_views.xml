<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_subscription_plan_list" model="ir.ui.view">
            <field name="name">subscription.plan.list</field>
            <field name="model">subscription.plan</field>
            <field name="arch" type="xml">
                <list string="Subscription Plans">
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="price_monthly" string="$/Month" />
                    <field name="rate_limit_per_hour" string="Req/h" />
                    <field name="token_expiry_hours" string="Token (h)" />
                    <field name="max_tickets_per_month" string="Tickets/Month" />
                    <field name="webhook_enabled" string="Webhooks" />
                    <field name="priority_support" string="Priority" />
                    <field name="sla_response_hours" string="SLA (h)" />
                    <field name="client_count" string="Clients" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="view_subscription_plan_form" model="ir.ui.view">
            <field name="name">subscription.plan.form</field>
            <field name="model">subscription.plan</field>
            <field name="arch" type="xml">
                <form string="Subscription Plan">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_clients" type="object"
                                class="oe_stat_button" icon="fa-users">
                                <field name="client_count" widget="statbutton" string="Clients" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" />
                            </h1>
                            <h4 class="text-muted">
                                <field name="code" readonly="1" />
                            </h4>
                        </div>
                        <group>
                            <group string="Pricing">
                                <field name="price_monthly" />
                                <field name="price_yearly" />
                                <field name="currency_id" />
                            </group>
                            <group string="API &amp; Token Limits">
                                <field name="rate_limit_per_hour" />
                                <field name="token_expiry_hours" />
                                <field name="max_active_tokens" help="0 = unlimited" />
                                <field name="recommended_sync_minutes" />
                            </group>
                        </group>
                        <group>
                            <group string="Ticket Limits">
                                <field name="max_tickets_per_month" help="0 = unlimited" />
                                <field name="max_open_tickets" help="0 = unlimited" />
                            </group>
                            <group string="Features">
                                <field name="webhook_enabled" />
                                <field name="priority_support" />
                                <field name="custom_fields_enabled" />
                                <field name="api_analytics_enabled" />
                            </group>
                        </group>
                        <group string="SLA Guarantees">
                            <field name="sla_response_hours" help="0 = no SLA" />
                            <field name="sla_resolution_hours" help="0 = no SLA" />
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"
                                placeholder="Describe what this plan includes…" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_subscription_plan" model="ir.actions.act_window">
            <field name="name">Subscription Plans</field>
            <field name="res_model">subscription.plan</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>