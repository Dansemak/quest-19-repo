<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Root menu -->
        <menuitem id="menu_helpdesk_root"
            name="Helpdesk"
            web_icon="helpdesk_server,static/description/icon.png"
            action="action_ticket_all"
            sequence="90"/>

            <!-- groups="helpdesk_server.group_helpdesk_user"  -->

        <!-- Tickets -->
        <menuitem id="menu_helpdesk_tickets"
            name="Tickets"
            parent="menu_helpdesk_root"
            sequence="10" />

        <menuitem id="menu_ticket_all"
            name="All Tickets"
            parent="menu_helpdesk_tickets"
            action="action_ticket_all"
            sequence="10"
            groups="helpdesk_server.group_helpdesk_manager" />

        <menuitem id="menu_ticket_my"
            name="My Tickets"
            parent="menu_helpdesk_tickets"
            action="action_ticket_my"
            sequence="20" />

        <menuitem id="menu_ticket_new"
            name="New Tickets"
            parent="menu_helpdesk_tickets"
            action="action_ticket_new"
            sequence="30"
            groups="helpdesk_server.group_helpdesk_manager" />

        <!-- Configuration (manager only) -->
        <menuitem id="menu_helpdesk_config"
            name="Configuration"
            parent="menu_helpdesk_root"
            sequence="90"
            groups="helpdesk_server.group_helpdesk_manager" />

        <menuitem id="menu_subscription_plan"
            name="Subscription Plans"
            parent="menu_helpdesk_config"
            action="action_subscription_plan"
            sequence="10" />

        <menuitem id="menu_client_subscription"
            name="Clients"
            parent="menu_helpdesk_config"
            action="action_client_subscription"
            sequence="20" />

        <menuitem id="menu_oauth_token"
            name="OAuth Tokens"
            parent="menu_helpdesk_config"
            action="action_oauth_token"
            sequence="30" />

    </data>
</odoo>