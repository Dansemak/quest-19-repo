<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_client_subscription_list" model="ir.ui.view">
            <field name="name">client.subscription.list</field>
            <field name="model">client.subscription</field>
            <field name="arch" type="xml">
                <list string="Clients"
                    decoration-danger="subscription_status == 'expired'"
                    decoration-warning="subscription_status == 'expiring_soon'"
                    decoration-muted="subscription_status == 'inactive'">
                    <field name="name" />
                    <field name="contact_id" />
                    <field name="plan_name" string="Plan" />
                    <field name="subscription_status" widget="badge"
                        decoration-success="subscription_status == 'active'"
                        decoration-warning="subscription_status == 'expiring_soon'"
                        decoration-danger="subscription_status == 'expired'"
                        decoration-muted="subscription_status == 'inactive'" />
                    <field name="expiry_date" />
                    <field name="days_until_expiry" string="Days Left" />
                    <field name="tickets_this_month" string="Tickets/Month" />
                    <field name="ticket_count" string="Total" />
                    <field name="active_tokens_count" string="Active Tokens" />
                    <field name="last_token_request" string="Last Auth" />
                </list>
            </field>
        </record>

        <record id="view_client_subscription_form" model="ir.ui.view">
            <field name="name">client.subscription.form</field>
            <field name="model">client.subscription</field>
            <field name="arch" type="xml">
                <form string="Client Subscription">
                    <header>
                        <button name="action_generate_oauth_credentials"
                            string="Generate OAuth Credentials"
                            type="object" class="oe_highlight"
                            groups="base.group_system" />
                        <button name="action_revoke_all_tokens"
                            string="Revoke All Tokens"
                            type="object"
                            confirm="Revoke all active tokens for this client?" />
                        <button name="action_generate_webhook_secret"
                            string="Generate Webhook Secret"
                            type="object"
                            invisible="webhook_enabled_by_plan == False" />
                        <button name="action_renew_subscription"
                            string="Renew (+1 Year)"
                            type="object" class="oe_highlight"
                            invisible="expiry_date == False" />
                        <field name="subscription_status" widget="statusbar"
                            statusbar_visible="active,expiring_soon,expired,inactive" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tickets" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="ticket_count" />
                                    </span>
                                    <span class="o_stat_text">Tickets</span>
                                </div>
                            </button>
                            <button name="action_view_tokens" type="object"
                                class="oe_stat_button" icon="fa-key">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="active_tokens_count" />
                                    </span>
                                    <span class="o_stat_text">Active Tokens</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group string="Client">
                                <field name="contact_id" />
                                <field name="email" />
                                <field name="phone" />
                            </group>
                            <group string="Subscription">
                                <field name="plan_id" />
                                <field name="subscription_active" />
                                <field name="start_date" />
                                <field name="expiry_date" />
                                <field name="days_until_expiry" string="Days Remaining"
                                    invisible="expiry_date == False" />
                                <field name="auto_renew" />
                            </group>
                        </group>

                        <!-- Read-only plan summary -->
                        <group string="Effective Limits (from Plan)">
                            <group>
                                <field name="rate_limit_per_hour" readonly="1" />
                                <field name="token_expiry_hours" readonly="1" />
                                <field name="sync_frequency_minutes" readonly="1" />
                            </group>
                            <group>
                                <field name="max_tickets_per_month" readonly="1"
                                    string="Tickets/Month Limit" />
                                <field name="tickets_this_month" readonly="1" />
                                <field name="monthly_price" readonly="1" />
                                <field name="priority_support" readonly="1" />
                            </group>
                        </group>

                        <notebook>
                            <page string="OAuth Credentials" groups="base.group_system">
                                <group>
                                    <group>
                                        <field name="client_id" readonly="1" />
                                        <field name="client_secret" password="True" />
                                        <field name="credentials_created" readonly="1" />
                                    </group>
                                    <group>
                                        <field name="last_token_request" readonly="1" />
                                        <field name="last_sync_time" readonly="1" />
                                    </group>
                                </group>
                                <div class="alert alert-warning" role="alert"
                                    invisible="client_secret == False"> ⚠️ <strong>Copy
                                        the Client Secret now.</strong> It will be hidden after you
                                    leave this page. </div>
                            </page>

                            <page string="Webhooks">
                                <div class="alert alert-info" role="alert"
                                    invisible="webhook_enabled_by_plan == True"> Webhooks are not
                                    included in the <strong>
                                        <field name="plan_name" readonly="1" />
                                    </strong>
                                    plan. Upgrade to Professional or Enterprise to enable webhooks. </div>
                                <group
                                    invisible="webhook_enabled_by_plan == False">
                                    <field name="webhook_active" />
                                    <field name="webhook_url"
                                        invisible="webhook_active == False"
                                        required="webhook_active == True" />
                                    <field name="webhook_secret" password="True"
                                        groups="base.group_system"
                                        invisible="webhook_active == False" />
                                </group>
                            </page>

                            <page string="Custom Limits">
                                <group>
                                    <div class="alert alert-info" role="alert">
                                        Leave these at 0 to use the plan defaults.
                                        Set a value to override for this client only.
                                    </div>
                                    <field name="custom_rate_limit"
                                        help="0 = use plan default" />
                                    <field name="custom_token_expiry"
                                        help="0 = use plan default" />
                                </group>
                            </page>

                            <page string="Notes">
                                <field name="notes" nolabel="1"
                                    placeholder="Internal notes about this client…" />
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>

        <record id="view_client_subscription_search" model="ir.ui.view">
            <field name="name">client.subscription.search</field>
            <field name="model">client.subscription</field>
            <field name="arch" type="xml">
                <search string="Clients">
                    <field name="name" />
                    <field name="contact_id" />
                    <field name="plan_id" />
                    <filter string="Active" name="f_active"
                        domain="[('subscription_status','=','active')]" />
                    <filter string="Expiring Soon" name="f_expiring"
                        domain="[('subscription_status','=','expiring_soon')]" />
                    <filter string="Expired" name="f_expired"
                        domain="[('subscription_status','=','expired')]" />
                    <filter string="Inactive" name="f_inactive"
                        domain="[('subscription_status','=','inactive')]" />
                    <separator />
                    <!-- <group string="Group By">
                        <filter string="Plan" name="by_plan" context="{'group_by': 'plan_id'}" />
                        <filter string="Status" name="by_status"
                            context="{'group_by': 'subscription_status'}" />
                    </group> -->
                </search>
            </field>
        </record>

        <record id="action_client_subscription" model="ir.actions.act_window">
            <field name="name">Clients</field>
            <field name="res_model">client.subscription</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_f_active': 1}</field>
        </record>

    </data>
</odoo>