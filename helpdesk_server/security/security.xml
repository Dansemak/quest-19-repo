<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">Helpdesk User</field>
            <!-- <field name="category_id" ref="base.module_category_services_helpdesk"/> -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Helpdesk Manager</field>
            <!-- <field name="category_id" ref="base.module_category_services_helpdesk"/> -->
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
            <!-- <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/> -->
        </record>

        <!-- Tickets: users see only tickets assigned to them; managers see all -->
        <record id="rule_ticket_user" model="ir.rule">
            <field name="name">Ticket: user sees assigned tickets</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="domain_force">[('assigned_to', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_ticket_manager" model="ir.rule">
            <field name="name">Ticket: manager sees all</field>
            <field name="model_id" ref="model_ticket_helpdesk"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Clients: manager only -->
        <record id="rule_client_manager" model="ir.rule">
            <field name="name">Client: manager only</field>
            <field name="model_id" ref="model_client_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Plans: users can read; managers full access -->
        <record id="rule_plan_user" model="ir.rule">
            <field name="name">Plan: user read-only</field>
            <field name="model_id" ref="model_subscription_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_plan_manager" model="ir.rule">
            <field name="name">Plan: manager full access</field>
            <field name="model_id" ref="model_subscription_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- OAuth tokens: manager only -->
        <record id="rule_token_manager" model="ir.rule">
            <field name="name">OAuth Token: manager only</field>
            <field name="model_id" ref="model_oauth_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
