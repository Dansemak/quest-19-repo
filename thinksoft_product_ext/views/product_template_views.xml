<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_tree_view_inherit_thinksoft_product_ext" model="ir.ui.view">
        <field name="name">product.template.view.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="description" optional="hide" />
            </xpath>

        </field>
    </record>

    <record id="product_template_search_view_inherit_thinksoft_product_ext" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <field name="description" />
            </xpath>

        </field>
    </record>

</odoo>
