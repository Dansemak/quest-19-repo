<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="shipping_label_3x4_template">
            <t t-call="web.html_container">
                <h1>Shipping Label 3x4</h1>
                <t t-foreach="docs" t-as="doc">
                    <t t-if="'partner_id' in doc.fields_get()">
                        <t t-call="thinksoft_labels.shipping_label_3x4_template_document" t-lang="doc.partner_id.lang" />
                    </t>
                    <t t-if="'partner_id' not in doc.fields_get()">
                        <t t-call="thinksoft_labels.shipping_label_3x4_template_document" />
                    </t>
                </t>
            </t>
        </template>

        <template name="Report without header and footer standard" id="report_external_layout_shipping_label_3x4">
            <div class="header">
            </div>
            <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0" />
            </div>
            <div class="footer">
            </div>
        </template>


        <template id="shipping_label_3x4_template_document">
            <t t-call="thinksoft_labels.report_external_layout_shipping_label_3x4">
                <style>
                    .main-page {
                        font-family: Arial, Helvetica, sans-serif;

                    }
                </style>
                <!-- <link rel="stylesheet" t-att-href="'/thinksoft_labels/static/src/css/report_style.css'" /> -->
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
                </t>
                <div class="main_page">
                    <div class="oe_structure" style="font-size:12px;">
                        <!-- <div class="container"> -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="" style="white-space: nowrap;">
                                        <div class="text-uppercase" data-name="Address Format" style="font-size:12px;">
                                            <span class="text-capitalize" style="">
                                                <font style="font-weight:bold;">ship to :</font>
                                            </span>
                                            <div class="address" style="line-height: 1.5; font-weight:normal!important;">
                                                <address t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <!-- </div> -->
                        <!-- <div class="container mt-3" style="white-space: normal;"> -->
                            <div class="row mt-3" style="white-space: normal;">
                                <div class="d-flex justify-content-between">
                                    <div class="info col-6" data-name="label: field">
                                        <span class="text-bold">PO #:</span>
                                        <b>
                                            <span class=" text-uppercase  ms-2" t-field="doc.origin" />
                                        </b>
                                    </div>
                                    <div class="info col-6 text-end" data-name="label: field">
                                        <span class="text-bold">SO #:</span>
                                        <b>
                                            <span class="text-uppercase ms-2" t-field="doc.sale_id" />
                                        </b>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="d-flex justify-content-between">
                                    <div class="info col-4 text-uppercase">
                                        <span class="text-bold">
                                        PIECES:
                                        </span>
                                    </div>
                                    <div class="col-8 text-uppercase text-end">
                                        <span class="text-bold">
                                        SHIP VIA:
                                        </span>
                                        <b>
                                            <span class="text-uppercase ms-2" t-field="doc.carrier_id.name" />
                                        </b>
                                    </div>
                                </div>
                            </div>
                        <!-- </div> -->
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
