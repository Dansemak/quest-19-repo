<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <template id="shipping_label_3x4_template">
        <t t-call="web.html_container">
            <h1>Shipping Label 3x4</h1>
            <t t-foreach="docs" t-as="doc">
                <!--
                    As language is not required for all objects.
                    So for now, If partner is available in object then pass
                    that partner's language.
                -->
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_3x4_template_document" t-lang="doc.partner_id.lang"/>
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_3x4_template_document"/>
                </t>
            </t>
        </t>
    </template>

    <template name="Report without header and footer standard" id="report_external_layout_shipping_label_3x4">
        <div class="header">
        </div>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <!-- <t t-call="quest_DO_reports.address_layout"/> -->
            <t t-raw="0"/>
        </div>
        <div class="footer">
        </div>
    </template>

