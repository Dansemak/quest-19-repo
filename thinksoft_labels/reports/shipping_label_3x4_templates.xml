    <template id="shipping_label_3x4_template_document">
        <t t-call="thinksoft_labels.report_external_layout_shipping_label_3x4">
            <!--
                        As language is not required for all objects.
                        So for now, If partner is available in object then pass
                        that partner's language.
                    -->
            <t t-if="'partner_id' in doc.fields_get()">
                <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
            </t>
            <div class="oe_structure" style="font-size:12px;">
                <!-- <div class="container-fluid triple_block mt16 mb16 report-container" data-name="Triple"> -->
                <!-- <div class="row"> -->
                <!-- <div class="col-4"> -->
                <!-- <div class="t_block mt8 mb8">
                  <img class="img img-responsive report-well" style="width: 300px; background: #dddddd;" data-name="&lt; img / &gt;" src="/quest_DO_reports/static/img/questlogo.png" data-original-title="" title="" aria-describedby="tooltip269202"/>
                </div> -->
                <!-- </div> -->
                <!-- </div> -->
                <!-- </div> -->
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="" style="white-space: nowrap;">
                                <div class="text-uppercase" data-name="Address Format" style="font-size:12px;">
                                    <span class="text-capitalize" style="">
                                        <font style="font-weight:bold;">ship to :</font>
                                    </span>
                                    <div class="address" style="line-height: 1.5; font-weight:normal!important;">
                                        <address t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container mt-3" style="white-space: normal;">
                    <div class="row">
                        <!-- <div class="col-5" style="white-space: nowrap;"> -->
                            <div class="d-flex justify-content-between">
                                <div class="col-6" data-name="label: field">
                                    <span class="text-bold">PO #:</span>
                                    <b>
                                        <!-- <span class=" text-uppercase text-bolder ml-2" t-field="doc.client_order_ref"/> -->
                                         <span class=" text-uppercase  ms-2" t-field="doc.origin"/>
                                    </b>
                                </div>
                                <div class="col-6" data-name="label: field">
                                    <span class="text-bold">S.O.No.:</span>
                                    <b>
                                        <span class="text-uppercase ms-2" t-field="doc.sale_id"/>
                                    </b>
                                </div>
                            </div>
                    </div>
                    <div class="row">
                        <!-- <div class="col-6"> -->
                            <div class="d-flex justify-content-between">
                                <div class="col-4 text-uppercase">
                                    <span class="text-bold">
                                        PIECES:
                                    </span>
                                        <!-- <span class="ml-2" t-field="doc.no_pieces"/> -->
                                </div>
                                <div class="col-8 text-uppercase ">
                                    <span class="text-bold">
                                        SHIP VIA:
                                    </span>
                                    <b>
                                        <!-- <span class="text-uppercase ml-2" t-field="doc.sale_id.sale_ship_via"/> -->
                                         <span class="text-uppercase ms-2" t-field="doc.carrier_id.name"/>
                                    </b>
                                </div>
                            </div>
                        <!-- </div> -->
                    </div>
                </div>
            </div>
        </t>
    </template>
    </data>
</odoo>