<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="label_4x4_for_all_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_labels.4x4_label_for_all_document" t-lang="doc.partner_id.lang" />
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_labels.4x4_label_for_all_document" />
                </t>
            </t>
        </t>
    </template>

    <template id="internal_layout_4x4_for_all">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="header">
            <style>
            
            .header {
                    font-family: Arial, Helvetica, sans-serif;
                }
            </style>
            <div class="row ">
                <div class="col-6" style="font-size:12px; padding-right:20px !important;">
                    <span class="text-uppercase" style="font-weight:bold;">Cust:</span>                       
                    <span class="code" style="margin-left:2px; font-weight:normal;line-height:1 !important;" t-field="doc.sale_id.partner_id.name" />
                </div>
                <div class="col-6">
                    <img class="img float-end" style="width:150px; display:block; horizontal-align:right; " data-name="&lt; img / &gt;" src="/thinksoft_labels/static/src/img/quest-logo-bw.jpg" />
                </div>
            </div>
        </div>
        <div class="article">
            <t t-raw="0" />
        </div>

    </template>

    <template id="4x4_label_for_all_document">
        <div class="main-page" style="margin:0 !important; ">
            <div class="oe_structure" style="">
                <div class="container" style="margin:0 !important; ">
                    <div class="row">
                        <table class="table" style="">
                            <!-- <tbody t-foreach="doc.move_lines" t-as="line"> -->
                            <tbody t-foreach="doc.move_ids" t-as="line">
                                <tr>
                                    <td>
                                        <div class="wrapper">
                                            <div class="container">
                                                <div class="row">
                                                    <t t-call="thinksoft_labels.internal_layout_4x4_for_all">
                                                        <link rel="stylesheet" t-att-href="'/thinksoft_labels/static/src/css/report_style.css'" />
                                                        <style>
                                                        .container {
                                                            font-family: Arial, Helvetica, sans-serif;
                                                        }
                                                        </style>
                                                        <div class="row mt-3" >
                                                            <div class="col-12" style="margin-top:30px !important; font-size:14px!important;">
                                                                <span class="text-uppercase" style="font-weight:bold; ">
                                                                P/N:</span>
                                                                <span class="code" style="margin-left:2px; font-size:14px!important; font-weight:normal;" t-field="line.product_id.name" />
                                                            </div>
                                                        </div>
                                                        <!-- ####################### DESCRIPTION  ############## -->
                                                

                                                        <div class="row mt-2">
                                                            <div class="col-12" style="font-size:14px!important;">
                                                                <span class="text-uppercase" style="font-weight:bold; font-size:14px!important;">
                                                                Description:</span>
                                                                <!-- <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important; font-weight:normal;" t-field="line.product_desc" /> -->
                                                                <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important; font-weight:normal; line-height:1.2; font-size:11px!important;" t-field="line.product_id.description" />
                                                            </div>
                                                        </div>
                                                        <!-- ############# DETAILS  ############## -->
                                               

                                                        <div class="row  mt-3">
                                                            <!-- ***************** QTY  ******** -->
                                                   

                                                            <div class="col-4">
                                                                <span class="text-uppercase" style="font-weight:bold; font-size:14px!important;">
                                                                Qty:________</span>
                                                            </div>
                                                            <!-- ************ BOX#  ************ -->
                                                    

                                                            <div class="col-4 text-center">
                                                                <span class="text-uppercase" style="font-weight:bold; font-size:14px!important;">
                                                                BOX#:________</span>
                                                            </div>
                                                            <!-- ************* SKID#  ************-->
                                                    
                                                            <div class="col-4 text-end">
                                                                <span class="text-uppercase" style="font-weight:bold; font-size:14px!important;">
                                                                SKID#:________</span>
                                                            </div>
                                                        </div>

                                                        <div class="row  mt-2" style="">
                                                            <!-- ********** PO#  ******** -->
                                                    
                                                            <div class="col-6" style="font-size:14px!important;">
                                                                <span class="text-uppercase" style="font-weight:bold; ">
                                                                C-PO#:</span>
                                                                <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important; font-weight:normal;" t-field="doc.client_order_ref" />
                                                                <!-- <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important; font-weight:normal;" t-field="doc.origin" /> -->
                                                            </div>
                                                            <!-- ************ SO#  ************ -->
                                                            <div class="col-6 text-end" style="font-size:14px!important;">
                                                                <span class="text-uppercase" style="font-weight:bold; margin-right:2px;">
                                                                SO#:</span>              
                                                                <span class="font-size:14px!important;" style="font-size:14px!important; font-weight:normal;" t-field="doc.origin" />
                                                            </div>
                                                        </div>
                                                        <div class="row mt-2" style="">
                                                            <!-- ********** HT#  ********** -->
                                                            <div class="col-12">
                                                                <span class="text-uppercase" style="font-weight:bold; font-size:14px!important;">
                                                                HEAT#:</span>
                                                                <!-- <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important;
                                                            font-weight:normal;" t-field="line.heat"/> -->
                                                            </div>
                                                        </div>
                                                        <div class="row  mt-2" style="">
                                                            <!-- ********** TAGGING  ******** --> 
                                                            <div class="col-12 " style="font-size:14px!important;">
                                                                <div>
                                                                    <span class="text-uppercase" style="font-weight:bold; ">
                                                                    TAGGING:</span>
                                                                    <span class="ms-2" style="color:#43464f; margin-left:2px; font-weight:normal;" t-field="line.tagging" />
                                                                </div>
                                                                <!-- <div>
                                                                    <span class="font-size:14px!important;" style="margin-left:2px;font-size:14px!important; font-weight:normal;" t-field="line.tagging" />
                                                                </div> -->
                                                            </div>

                                                        </div>
                                                    </t>

                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </template>

</odoo>