<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- All of the ir.actions.reports live here -->
     
        <!--^********************************* Print Label 1.25x4 *********************************-->
        <record id="action_report_print_label_1_25x4" model="ir.actions.report">
            <field name="name">Print Label 1.25x4</field>
            <field name="model">stock.picking</field>  <!-- Replace with actual model -->
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thinksoft_labels.print_label_1_25x4_template</field>
            <field name="report_file">thinksoft_labels.print_label_1_25x4_template</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="paperformat_id" ref="thinksoft_labels.paperformat_print_label_1_25x4"/>
            <field name="print_report_name">'Label - %s' % (object.name)</field>
        </record>
        <!--^********************************* Shipping Label 3x4 *********************************-->
