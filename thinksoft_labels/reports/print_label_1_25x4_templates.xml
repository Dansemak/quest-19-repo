<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="print_label_1_25x4_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-if="'partner_id' in doc.fields_get()">
                        <t t-call="thinksoft_labels.print_label_1_25x4_template_document" t-lang="doc.partner_id.lang" />
                    </t>
                    <t t-if="'partner_id' not in doc.fields_get()">
                        <t t-call="thinksoft_labels.print_label_1_25x4_template_document" />
                    </t>
                </t>
            </t>
        </template>

        <template id="print_label_1_25x4_template_document">
            <div class="main-page" style="padding: 5px 0 !important;">
                <style>
                @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&amp;family=Sansation:wght@700&amp;display=swap');
                .container {
                    font-family: 'Roboto Condensed','Sansation',  sans-serif ;
                }
                </style>
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
                </t>
                <link rel="stylesheet" t-att-href="'/thinksoft_labels/static/src/css/report_style.css'" />
                <div class="oe_structure" style="white-space: nowrap; font-family: 'Roboto Condensed','Sansation',  sans-serif ;">
                    <div class="container" style="">
                        <div class="col-6" style="float: left; font-family:sans-serif;font-size: 12px; margin-bottom: 10px; font-weight: bold;">Item Code:</div>
                        <div class="col-6" style="float: left; font-family:sans-serif;font-size: 14px; margin-left:20px;">
                            <span t-field="doc.product_id" />
                        </div>
                        <div style=" clear:both; font-family:sans-serif;font-size: 12px; margin: 20px 0 8px; font-weight: bold;">Description:</div>
                        <div style="font-family:sans-serif;font-size: 14px;">
                            <span t-field="doc.name" />
                        </div>
                        <div class="row d-flex justify-content-between" style="position:fixed; bottom: 5px;font-family:sans-serif;font-size: 12px;">
                            <div class="col-4" style="float:left; font-weight: bold;">QTY:<span t-esc="doc.product_id.qty_available" style="font-weight: normal;margin-left:3px;"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

    </data>
</odoo>