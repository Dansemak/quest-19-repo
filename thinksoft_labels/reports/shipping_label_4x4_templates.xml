    <template id="shipping_label_4x4_template">
        <t t-call="web.html_container">
            <!-- <h1>Shipping Label 4x4</h1> -->
            <t t-foreach="docs" t-as="doc">
                <!--
                    As language is not required for all objects.
                    So for now, If partner is available in object then pass
                    that partner's language.
                -->
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_4x4_template_document"
                        t-lang="doc.partner_id.lang" />
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_4x4_template_document" />
                </t>
            </t>
        </t>
    </template>


    <template id="report_external_layout_shipping_label_4x4">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="header">
            <div class="container" style="font-size:12px; margin:0 !important; ">
                <div class="row" style="">
                    <div class="col-6">
                        <span class="text-uppercase"
                            style="font-size:12px; font-weight:bold;">
                            Cust:</span>
                        <span class="code"
                            style="margin-left:2px;color:#43464f;font-size:10px;"
                            t-field="doc.sale_id.partner_id" />
                    </div>
                    <div class="col-6">
                        <img class="img float-end" style="width:150px; display:block; "
                            data-name="&lt; img / &gt;"
                            src="/thinksoft_labels/static/src/img/quest-logo-bw.jpg" />                           
                    </div>
                </div>
            </div>
        </div>
        <div class="article">
            <t t-raw="0" />
        </div>
    </template>

