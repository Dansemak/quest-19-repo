<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="shipping_label_4x4_template">
        <t t-call="web.html_container">
            <!-- <h1>Shipping Label 4x4</h1> -->
            <t t-foreach="docs" t-as="doc">
                <!--
                    As language is not required for all objects.
                    So for now, If partner is available in object then pass
                    that partner's language.
                -->
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_4x4_template_document" t-lang="doc.partner_id.lang" />
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_labels.shipping_label_4x4_template_document" />
                </t>
            </t>
        </t>
    </template>


    <template id="report_external_layout_shipping_label_4x4">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id" />
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company" />
        </t>
        <div class="header">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&amp;family=Sansation:wght@700&amp;display=swap');
            .container {
                    font-family: 'Roboto Condensed','Sansation',  sans-serif ;
                }
            </style>
            <div class="container" style="font-size:12px; margin:0 !important; ">
                <div class="row" style="">
                    <div class="col-6">
                        <span class="text-uppercase" style="font-size:12px; font-weight:bold;">
                            Cust:</span>
                        <span class="code" style="margin-left:2px;color:#43464f;font-size:10px;" t-field="doc.sale_id.partner_id.name" />
                    </div>
                    <div class="col-6">
                        <img class="img float-end" style="width:150px; display:block; " data-name="&lt; img / &gt;" src="/thinksoft_labels/static/src/img/quest-logo-bw.jpg" />
                    </div>
                </div>
            </div>
        </div>
        <div class="article">
            <t t-raw="0" />
        </div>
    </template>

    <template id="shipping_label_4x4_template_document">
        <t t-call="thinksoft_labels.report_external_layout_shipping_label_4x4">
            <link rel="stylesheet" t-att-href="'/thinksoft_labels/static/src/css/report_style.css'" />
            <t t-if="'partner_id' in doc.fields_get()">
                <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
            </t>
            <div class="main-page">
                <div class="oe_structure" style="font-size:13px;">
                    <div class="container">
                        <div class="row">
                            <div class="col-12" style="margin-top:30px;">
                                <div class="" style="white-space: nowrap;">
                                    <div class="text-uppercase" data-name="Address Format" style="">
                                        <span class="text-capitalize" style="">
                                            <font style="font-weight:bold; font-size:12px;">ship to :</font>
                                        </span>
                                        <div class="" style="line-height: 1.5; font-weight:normal!important;">
                                            <address t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- </div>
                        <div class="container mt-3" style=""> -->
                        <!--#######################
                        SHIP VIA ####################-->


                        <div class="row mt-3">
                            <div class="col-12">
                                <span style="font-weight:bold;">
                                    SHIP VIA:
                                </span>
                                <span class="text-uppercase ms-2" style="color:#43464f; font-weight:normal;" t-field="doc.sale_id.carrier_id.name" />
                            </div>
                        </div>
                        <!--#######################
                        PO# / SO# ####################-->
                        <div class="row mt-3" style="">
                            <!--**********
                            PO#  ********-->
                            <div class="info col-6">
                                <span class="text-uppercase" style="font-weight:bold;">
                                    C-PO#:</span>
                                <!-- <span class="item" style="margin-left:2px;color:#43464f; font-weight:normal;" t-field="doc.client_order_ref" /> -->
                                <span class=" text-uppercase  ms-2" t-field="doc.origin" />
                            </div>
                            <!--************
                            PO#  **********-->
                            <div class="info col-6">
                                <span class="text-uppercase" style="font-weight:bold;">
                                    SO#:</span>
                                <span class="item" style="margin-left:2px; color:#43464f; font-weight:normal;" t-field="doc.origin" />
                            </div>
                        </div>
                        <!--#######################
                        No. PIECES ####################-->
                        <div class="row mt-3">
                            <div class="info col-12" style="white-space: nowrap;">
                                <span style="font-weight:bold;">No. Pieces:_______</span>
                                <!-- <span class="text-uppercase ml-2" t-field="doc.no_piecess" /> -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>