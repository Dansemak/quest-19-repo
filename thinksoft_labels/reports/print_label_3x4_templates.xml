<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="print_label_3x4_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="'partner_id' in doc.fields_get()">
                    <t t-call="thinksoft_labels.print_label_3x4_template_document" t-lang="doc.partner_id.lang"/>
                </t>
                <t t-if="'partner_id' not in doc.fields_get()">
                    <t t-call="thinksoft_labels.print_label_3x4_template_document"/>
                </t>
            </t>
        </t>
    </template>

    <template id="internal_layout_product_3x4_label">
		<!-- Multicompany -->
		<t t-if="o and 'company_id' in o">
			<t t-set="company" t-value="o.company_id" />
		</t>
		<t t-if="not o or not 'company_id' in o">
			<t t-set="company" t-value="res_company" />
		</t>
		<div class="header">
			<div class="row">
             
			</div>
		</div>
		<div class="article">
			<t t-raw="0" />
		</div>
        <div class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-12" style="text-align: center;font-size: 8px;">www.questgasket.com</div> 
                </div>
            </div>
        </div>
	</template>

    <template id="print_label_3x4_template_document">
        <t t-call="thinksoft_labels.internal_layout_product_3x4_label">
            <div class="page">
                <div class="container" style="margin:0 !important; padding:0 !important;">
                    <div class="row">
                        <div class="col-12" style="text-align:center;font-weight:bold;">
                            <span t-field="doc.product_id"/>
                        </div>
                    </div>
                    <div class="row" style="margin:10px 0 0 0 !important;">
                        <div class="col-6" style="font-size: 12px; margin:0 !important;">
                            <span style="font-weight:bold;">QTY: ____</span>
                        </div>
                        <div class="col-6" style="font-size: 12px; margin:0 !important;">
                            <span style="margin-left:20px;">MO:</span>
                            <span t-field="doc.name" style="text-align:right; margin-left:2px; font-weight:bold;"/>
                        </div>
                    </div>
                    <div class="row" style="margin:10px 0 0 0 !important;">
                        <div class="col-6" style="font-size: 12px; margin:0 !important;">
                            <span style="font-weight:bold;">BOX ____ OF ____</span>
                        </div>
                        <div class="col-6" style="font-size:12px; margin:0 !important;">
                            <span style="margin-left:20px;">SO:</span>
                            <span t-field="doc.origin" style="text-alighn:right; margin-left:2px; font-weight:bold;"/>
                        </div>
                    </div>
                    <div class="row" style="margin:10px 0 0 0 !important;">
                        <div class="col-6" style="font-size: 12px; margin:0 !important;">
                            <span style="font-weight:bold;">HEAT #:</span>
                        </div>
                    </div>
                    <t t-if="not doc.picking_ids.note">
                        <div class="row" style="margin:0 !important;">
                            <div class="col-12" style=" font-size:12px; line-height:1.2; margin:8px 0 5px 0 !important;  text-align:center;">
                                <span t-field="doc.product_id.description"/>
                            </div>
                        </div>
                    </t>
                    <t t-if="doc.picking_ids.note">
                        <div class="row" style="margin:0 !important;">
                            <div class="col-12" style=" font-size:12px; line-height:1.2; margin:8px 0 5px 0 !important; text-align:center;text-transform: uppercase;">
                                <span t-field="doc.picking_ids.note"/>
                            </div> 
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>