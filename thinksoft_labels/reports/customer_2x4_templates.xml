<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_2x4_label_template">
        <t t-call="web.basic_layout">
            <style>
                .label-container {
                    width: 100%;
                    height: 46mm;
                    padding: 2mm;
                    box-sizing: border-box;
                    font-family: Arial, sans-serif;
                    text-align: center;
                    overflow: hidden;
                }
                .logo-section {
                    width: 100%;
                    margin-bottom: 2mm;
                }
                .logo-section img {
                    max-width: 80%;
                    max-height: 15mm;
                }
                .product-code {
                    font-size: 14pt;
                    font-weight: bold;
                    margin: 1mm 0;
                    padding: 1mm 0;
                    <!-- border-bottom: 1px solid #000; -->
                }
                .product-name {
                    font-size: 9pt;
                    margin-top: 1mm;
                    line-height: 1.2;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <t t-set="product" t-value="doc if doc._name == 'product.template' else doc.product_id"/>
                    <div class="label-container">
                        <div class="logo-section">
                            <t t-if="doc.partner_id.image_1920">
                                <img t-att-src="image_data_uri(doc.partner_id.image_1920)"/>
                            </t>
                            <t t-else="">
                                <img src="/thinksoft_labels/static/src/img/quest-crest.jpg"/>
                            </t>
                        </div>
                        <div class="product-code">
                            <span t-field="doc.product_id.name"/>
                        </div>
                        <div class="product-name">
                            <span t-field="doc.product_id.description" />
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>