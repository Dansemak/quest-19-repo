<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <template id="certificate_of_compliance_template">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <h1>Certificate Of Compliance</h1>
          <!--
                    As language is not required for all objects.
                    So for now, If partner is available in object then pass
                    that partner's language.
                -->
          <t t-if="'partner_id' in doc.fields_get()">
            <t t-call="thinksoft_reports.certificate_of_compliance_document"
              t-lang="doc.partner_id.lang" />
          </t>
          <t t-if="'partner_id' not in doc.fields_get()">
            <t t-call="thinksoft_reports.certificate_of_compliance_document" />
          </t>
        </t>
      </t>
    </template>
    <template name="Report header and footer standard" id="report_external_layout_certificate_of_compliance">
      <div class="header pe-5" style="">
        <style>
            <!-- @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&amp;family=Sansation:wght@700&amp;display=swap'); -->
           .header,.footer {
                font-family: Arial, Helvetica,  sans-serif ;
              }
            .top-address{
                line-height:1; font-size:13px; font-family:Arial, Helvetica,sans-serif;
              }
            .title{
                <!-- font-family:'Oswald', -->
                font-family:Arial, Helvetica, sans-serif;
                sans-serif !important;
                font-size: 23px !important;
                font-weight: bold !important;
                text-align: left !important;
                line-height: 1.2 !important;
              }
            .barcode{
                font-size:14px !important;  margin-top:4px !important; font-weight:bold !important;font-family:Arial, Helvetica,sans-serif;
              }
        </style>
        <div class="container">
          <div class="row mb-2">
            <!-- ******************** LOGO ******************** -->
            <div class="col-4">
              <div class="">
                <img class="img img-responsive " style="width: 200px;" src="/thinksoft_reports/static/src/img/quest-logo.jpg" />
              </div>
            </div>
            <!-- ******************** ADDRESS ******************** -->
            <div class="col-3 top-address">
              <p style="">Quest Gasket &amp; Supply Inc<br /> Unit
                500, 3260 16 Street <br /> Nisku, AB, T9E 1P5 <br /> P: 780.463.4049 | F:
                780.461.7009</p>
            </div>
            <!-- ******************** TITLE ******************** -->
            <div class="col-5 d-flex justify-content-end " style=" ">
              <div style="padding:0!important; text-align:center; ">
                <!-- ******************** BARCODE ******************** -->
                <span t-field="doc.name"
                  t-options='{"widget": "barcode", "barcode_type": "Code128", "width":200, "height":30}'
                  style="" />
                <br />
                <div class="barcode" t-field="doc.name" />
              </div>
              <!-- ******************** TITLE ******************** -->
              <div class="title text-uppercase" style="white-space: normal; ">
                Certificate of <br/>Compliance
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
        t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-raw="0" />
      </div>

        <div class="footer" style="font-size:11px; width:100%;">
        <div class="container ">
          <div class="row">
            <div class="col-12">
              <span class="text-left" style="">Print Date:</span>
              <span class="ms-2"
                t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y %H:%M:%S')"
                style="margin-right: 250px; text-align: right;" />
              <span style="font-size: 11px; text-align: center; color: #525659;">www.questgasket.com</span>
              <div style="display: inline-block; float: right;">Page: <span class="page ms-2" /> of <span
                  style="text-align: right;" class="topage" /></div>
            </div>
          </div>
        </div>
      </div>
    </template>
    <template id="certificate_of_compliance_document">
      <t t-call="thinksoft_reports.report_external_layout_certificate_of_compliance">
          <link rel="stylesheet" t-att-href="'/thinksoft_reports/static/src/css/report_style.css'"/>
      <div class="main_page" style="">
          <!--
                      As language is not required for all objects.
                      So for now, If partner is available in object then pass
                      that partner's language.
                  -->
          <t t-if="'partner_id' in doc.fields_get()">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
          </t>
          <div class="oe_structure" style="">
            <div class="container">
              <div class="row">
                <!-- ******************** SHIP TO ******************** -->
                <div class="info1 col-6" >
                  <table class="text-uppercase" style=" border-collapse:collapse; width:100%;">
                    <tbody>
                      <tr>
                        <th
                          style="border: 1px solid #525659; border-top-color: #525659; text-align: center;">Ship
                          to</th>
                      </tr>
                      <tr>
                      <td class="address" style="border-bottom-color: 0px solid #fff; ">
                            <address t-field="doc.sale_id.partner_shipping_id" t-options="{
                                'widget': 'contact',
                                'fields': ['name', 'address'],
                                'no_marker': True
                                }" />   
                          <!-- <address t-field="doc.sale_id.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,], &quot;no_marker&quot;: True}"/> -->
                        </td>
                      </tr>

                      <tr>
                        <th style="border: 1px solid #525659; text-align: center;">Contact</th>
                      </tr>
                      <tr>
                        <td style="">
                          <span class="" t-field="doc.partner_id.name"/>
                        </td>
                      </tr>
                      <tr>
                        <th style="border: 1px solid #525659; text-align: center;">phone</th>
                      </tr>
                      <tr>
                        <td style="">
                          <span class="" t-field="doc.partner_id.phone" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <!-- ******************** REPORT INFO ******************** -->
                <div class="info col-6" style="">
                  <table class="text-uppercase" style="border-collapse:collapse;">
                    <tbody style="">

                      <tr>
                        <th
                          style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">DATE</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.create_date" />
                        </td>
                      </tr>
                      <tr>
                        <th
                          style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                           <span class="">Customer Reference</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.client_order_ref" />
                        </td>
                      </tr>
                      <tr style="border: 1px solid #525659;">
                        <th
                          style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Salesperson</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.salesperson_id" />
                        </td>
                      </tr>
                      <tr>
                        <th
                          style="text-align: right; white-space: nowrap; border-top-color: #525659; border: 1px solid #525659;">
                          <span class="text-capitalize"> BUYER</span>
                        </th>
                        <td style="border-top-color: #525659; border: 1px solid #525659;">
                          <span class="" t-field="doc.partner_contact_id.name" />
                        </td>
                      </tr>
                    </tbody>
                  </table>

                  <div class="note " style="margin-top:28px; ">
                    <table class="table table-hover" style=" border-collapse:collapse;">
                      <tbody>
                        <tr>
                          <td colspan="2"
                            style="height:60px;  white-space: normal; line-height:1.2; text-transform:none;">
                            This document certifies that the materials or finished goods requested
                            are in
                            conformance with the specified guidelines provided to Quest Gasket by
                            the above listed
                            company. We certify that the goods identified above conform to the
                            requirements of the
                            purchase order and meet the applicable industrial standards.
                          </td>
                        </tr>
                        <tr>
                          <th style="text-transform:none !important; width:150px;">Authorized
                            Signature</th>
                          <td />
                        </tr>
                      </tbody>
                    </table>
                  </div>

                </div>
              </div>


            </div>
            <div class=" container " style="margin:20px 0 20px;">
              <div class="row items">
                <div class="col-12">
                  <div class="no-break-wrapper" style="">
                    <table class="line-items" style="width:100%;">
                      <thead style="">
                        <div style="clear:both;">
                          <tr>
                            <th rowspan="2"
                              style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; width: 40px;">
                              Line</th>
                            <th
                              style="text-align:left; border-top-color: solid #525659;  border-bottom-color: #525659;">Part
                              #</th>
                            <th rowspan="2"
                              style="width:100px; border-top-color: #525659; border-botttom-color: #525659;">QTY
                              shipped</th>
                            <th rowspan="2"
                              style="width:100px; border-top-color: #525659; border-botttom-color: #525659; ">
                              UoM</th>
                          </tr>
                          <tr>
                            <th style="text-align:left;  border-bottom-color: #525659; ">Description</th>
                          </tr>
                        </div>
                      </thead>
                      <!-- <tbody t-foreach="doc.move_lines" t-as="line"> -->
                      <!-- <tbody t-foreach="doc.move_line_ids" t-as="line" style=""> -->
                      <tbody t-foreach="doc.move_ids" t-as="line">
                      <!-- <tbody t-foreach="doc.move_ids" t-as="line"> -->
                        <tr style="">
                          <!-- ******************** line # ******************** -->
                          <td rowspan="2" class="text-center" style="">
                            <span t-field="line.seq_no" style=""/>
                          </td>
                           <td >
                            <!-- ******************  Part # ****************** -->
                            <div style="padding:0; display:inline; text-align: left; margin-bottom: 3px; font-weight: bold;" class=" text-uppercase" t-field="line.product_id" />
                            <!-- ******************  Description ****************** -->
                            <t t-set="desc" t-value="(line.product_id.description or '').replace('&lt;', ' ').replace('&gt;', ' ').replace('\n', ' ').replace('\r', ' ').strip()"/>
                            <t t-raw=" ' '.join(desc.split()) " />
                          </td>
                          <!-- ******************** PICK QTY ******************** -->
                          <td colspan="" class="text-center">
                            <span class="" t-field="line.quantity" />
                          </td>
                          <!-- ******************** UOM ******************** -->
                          <td class="text-center">
                            <span t-field="line.product_uom" style="" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
      </div>
      </t>
    </template>

  </data>
</odoo>