<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- All of the ir.actions.reports live here -->

     <!--////////////////////////////////  PAPERFORMATS //////////////////////////////////////////////-->

        <!--*************************************** MAINN REPORTS PAPERFORMAT  ************************************-->
        <record id="thinksoft_reports_paperformat" model="report.paperformat">
            <field name="name">Reports Paper Format</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">279</field>
            <field name="page_width">216</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">22</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">18</field>
            <field name="dpi">90</field>
        </record>
        <!--***************************** PRINT LABEL 1.25x4 PAPERFORMAT *************************************-->
        <record id="paperformat_print_label_1_25x4" model="report.paperformat">
            <field name="name">1.25x4 Paper Format</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">31</field>
            <field name="page_width">101</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2</field>
            <field name="margin_bottom">1</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">37</field>
            <field name="dpi">80</field>
        </record>
        <!--*************************************** SHIPPING LABEL 3x4 PAPERFORMAT  ************************************-->
        <record id="shipping_label_3x4_paperformat" model="report.paperformat">
            <field name="name">Shipping Label 3x4 Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">70</field>
            <field name="page_width">95</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">80</field>
        </record>
      
    </data>
</odoo>