<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
  <template id="order_confirmation_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <h1>Order Confirmation</h1>
        <!--
              As language is not required for all objects.
              So for now, If partner is available in object then pass
              that partner's language.
          -->
        <t t-if="'partner_id' in doc.fields_get()">
          <t t-call="thinksoft_reports.order_confirmation_template_document" t-lang="doc.partner_id.lang" />
        </t>
        <t t-if="'partner_id' not in doc.fields_get()">
          <t t-call="thinksoft_reports.order_confirmation_template_document" />
        </t>
      </t>
    </t>
  </template>
  <template name="Report with header and footer standard" id="report_external_layout_order_confirmation">
      <div class="header pe-5" style="">
        <style>
            .header,.footer {
                font-family: Arial, Helvetica, sans-serif;
                }
            .top-address{
                line-height:1; font-size:13px; font-family:Arial, Helvetica, sans-serif;
            }
            .title{
                <!-- font-family:'Oswald',sans-serif !important; -->
                font-family:Arial, Helvetica, sans-serif;
                font-size: 24px !important;
                font-weight: bold !important;
                line-height: 1.2 !important;
                text-align: left !important;
            }
            .barcode{
                font-size:14px !important;  margin-top:4px !important; font-weight:bold !important;font-family:Arial, Helvetica, sans-serif;
            }
        </style>
        <div class="container">
          <div class="row mb-2">
            <!-- ********************************* LOGO
            ********************************************* -->
            <div class="col-4">
              <div class="">
                <img class="img img-responsive " style="width: 200px;" src="/thinksoft_reports/static/src/img/quest-logo.jpg" />
              </div>
            </div>
            <!-- ************************************** ADDRESS *************************** -->
            <div class="col-3 top-address">
              <p style="">Quest Gasket &amp; Supply Inc<br /> Unit
                500, 3260 16 Street <br/> Nisku, AB, T9E 1P5 <br/> P: 780.463.4049 | F:
                780.461.7009</p>
            </div>
            <!-- ************************************** TITLE
            ******************************************** -->
            <div class="col-5 d-flex justify-content-end " style=" ">
              <div style="padding:0!important; text-align:center; ">
                <!--**********************
                BARCODE *********************-->
                <span t-field="doc.name"
                  t-options='{"widget": "barcode", "barcode_type": "Code128", "width":200, "height":30}'
                  style="" />
                <br />
                <div class="barcode" t-field="doc.name" />
              </div>
              <!--**********************
              TITLE *********************-->
              <div class="title text-uppercase">
                Order<br/> Confirmation
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
        t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-raw="0" />
      </div>
      <!-- <div class="footer "
        style="font-size:11px; width:100%;border-top:3px solid #c30000; padding-top:8px; "> -->
        <div class="footer" style="font-size:11px; width:100%;">
        <div class="container ">
          <div class="row">
            <div class="col-12">
              <span class="text-left" style="">Print Date:</span>
              <span class="ms-2"
                t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y %H:%M:%S')"
                style="margin-right: 250px; text-align: right;" />
              <span style="font-size: 11px; text-align: center; color: #525659;">www.questgasket.com</span>
              <div style="display: inline-block; float: right;">Page: <span class="page ms-2" /> of <span
                  style="text-align: right;" class="topage" /></div>
            </div>
          </div>
        </div>
      </div>
    </template>
  <template id="order_confirmation_template_document">
  <t t-call="thinksoft_reports.report_external_layout_order_confirmation">
        <link rel="stylesheet" t-att-href="'/thinksoft_reports/static/src/css/report_style.css'"/>
    <div class="main_page">
        <!--
          As language is not required for all objects.
          So for now, If partner is available in object then pass
          that partner's language.
        -->
        <t t-if="'partner_id' in doc.fields_get()">
          <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
        </t>
        <div class="oe_structure" style="font-size: 11px;">
          <div class="container">
            <div class="row">
              <!-- ************************************** SHIP TO ******************************************** -->
              <div class="info1 col-6" >
                <table class="text-uppercase" style=" border-collapse:collapse;">
                  <tbody style="">
                    <tr>
                      <th style=" border: 1px solid #525659; border-top-color: #525659;font-size: 11px; text-align: center;">Ship to</th>
                    </tr>
                    <tr>
                        <td class="address" style="border-bottom-color: 0px solid #fff; ">
                          <address t-field="doc.sale_id.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                        </td>
                        </tr>
                        <tr>
                          <th style=" height:11.5px; border: 1px solid #525659; font-size: 11px; text-align: center;">Contact</th>
                        </tr>
                        <tr>
                          <td class="address" style="">
                            <span class="" t-field="doc.partner_contact_id.name"/>
                          </td>
                        </tr>
                        <tr>
                          <th style=" text-align: center; height:11.5px; border: 1px solid #525659; font-size: 11px;">phone</th>
                        </tr>
                        <tr>
                          <td class="address" style="">
                            <span class="" t-field="doc.partner_contact_id.phone" />
                          </td>
                        </tr>
                  </tbody>
                </table>
              </div>
              <!-- ************************************** REPORT INFO ******************************************** -->
              <div class="info col-6">
                <table class=" text-uppercase" style="border-collapse:collapse;">
                  <tbody style="">
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">DATE</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                        <span class="" t-field="doc.create_date"/>
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">DELIVERY DATE</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                        <span class="" t-field="doc.sale_id.commitment_date" />
                        <!-- <span class="" t-field="doc.scheduled_date"/> -->
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border-top-color: #525659; border: 1px solid #525659;">
                        <span>CUSTOMER</span>
                      </th>
                      <td style="border-top-color: #525659; border: 1px solid #525659;">
                        <!-- <span class="" t-field="doc.partner_id.name" /> -->
                        <t t-set="cust_name" t-value="doc.partner_id.name or ''"/>
                          <span t-esc="cust_name[:20]"/>
                      </td>
                    </tr>
                    <tr style="border: 1px solid #525659;">
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">CUSTOMER REFERENCE</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                        <span class="" t-field="doc.client_order_ref" />
                         <!-- <span class="" t-field="doc.origin" /> -->
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border-top-color: #525659; border: 1px solid #525659;">
                        <span>TERMS</span>
                      </th>
                      <td style="border-top-color: #525659; border: 1px solid #525659;">
                        <span class="" t-field="doc.sale_id.payment_term_id" />
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">SALESPERSON</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                        <span class="" t-field="doc.salesperson_id" />
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">SHIPPING INFOMATION</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                         <span t-field="doc.carrier_id.name"/>
                      </td>
                    </tr>
                    <tr>
                      <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                        <span class="">FOB</span>
                      </th>
                      <td style="border: 1px solid #525659;">
                        <span class="" t-field="doc.sale_id.warehouse_id.name"/>
                        <!-- <span class="" t-field="doc.sale_freight_id"/> -->
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class=" container" style="margin:20px 0 20px;">
            <div class="row items">
              <div class="col-md-12 col-xs-12">
                <div class="">
                  <table class="line-items" style="width:100%; ">
                    <thead style="">
                      <div style="clear:both;">
                        <tr>
                          <th rowspan="2" style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; width: 40px;">Line</th>
                          <th style="text-align:left; border-top-color: solid #525659;  border-bottom-color: #525659;">Part #</th>
                          <th rowspan="2" style=" border-top-color: #525659; border-botttom-color: #525659;"> QTY ORD</th>
                          <th rowspan="2" style="border-top-color:#525659;">
                            <span style="">QTY SHP</span>
                          </th>
                          <th rowspan="2" style="white-space: nowrap; border-top-color: #525659; ">QTY BO</th>
                          <th rowspan="2" style="text-align: right;">UNIT PRICE</th>
                          <th rowspan="2" style="border-top-color: #525659; border-botttom-color: #525659; ">UoM</th>
                          <th rowspan="2" style="white-space: nowrap; border-top-color: #525659; text-align: right;">ext. Price</th>
                        </tr>
                        <tr>
                          <th style="text-align:left;  border-bottom-color: #525659; ">Description</th>
                        </tr>
                      </div>
                    </thead>
                     <!-- <tbody t-foreach="doc.move_line_ids" t-as="line" style=""> -->
                     <tbody t-foreach="doc.move_ids" t-as="line" t-index="line_index">
                      <tr style="">
                       <!--*************** line ***************-->
                        <td rowspan="2" class="text-center" style="">
                          <span t-field="line.seq_no" style="" />
                        </td>
                        <td >
                          <!-- ******************  Part # ****************** -->
                          <div style="padding:0; display:inline; text-align: left; margin-bottom: 3px; font-weight: bold;" class=" text-uppercase" t-field="line.product_id" />
                          <!-- ******************  Description ****************** -->
                          <t t-set="desc" t-value="(line.product_id.description or '').replace('&lt;', ' ').replace('&gt;', ' ').replace('\n', ' ').replace('\r', ' ').strip()"/>
                          <t t-raw=" ' '.join(desc.split()) " />

                              <!-- <div style="line-height:1.3 !important; margin:0; padding:0; display:inline; color:#5b5b5b !important;" t-esc="(line.product_id.description or '').replace('&lt;', ' ').replace('&gt;', ' ').replace('\n', ' ').replace('\r', ' ').strip()"/> -->
                        </td>
                        <!--******************* QTY ORD **************-->
                        <td class="text-center">
                          <!-- <span t-field="line.product_uom_qty" /> -->
                           <span class="" t-field="line.sale_line_id.product_uom_qty" />
                        </td>
                        <!--******************* QTY SHP **************-->
                        <td colspan="" class="text-center">
                          <!-- <span t-field="line.quantity_done" /> -->
                           <span t-field="line.quantity" />
                        </td>
                        <!--***************** BO ****************-->
                        <!-- <td colspan="" class="text-center"><span t-field=" line.probo_qty"></span></td> -->
                        <td colspan="" class="text-center">
                          <!-- <span t-esc=" (line.product_uom_qty - line.quantity_done)"></span> -->
                           <span t-esc=" (line.sale_line_id.product_uom_qty - line.quantity)"></span>
                        </td>

                        <!--***************** UNIT PRICE ****************-->
                        <td class="text-end">
                          <span style="margin-right:2px;">$</span>
                          <span t-esc="'{:.2f}'.format(line.sale_line_id.price_unit * (1 - (line.sale_line_id.discount / 100)))" />
                        </td>
                        <!--***************** UOM ****************-->
                        <td class="text-center">
                          <span t-field="line.product_uom" style="" />
                        </td>
                        <!--***************** ext. Price ****************-->
                        <td colspan="" class="text-end">
                          <span style="margin-right:2px;">$</span>
                          <span class="" t-esc="'{:.2f}'.format(line.sale_line_id.price_unit * (1 - (line.sale_line_id.discount / 100)) * line.quantity)" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

    </div>
    </t>
  </template>
  </data>
</odoo>