            <field name="paperformat_id" ref="thinksoft_reports.thinksoft_reports_paperformat" />
            <field name="binding_type">report</field>
            <field name="domain">[('picking_type_id.sequence_code', 'in', ['PICK', 'OUT'])]</field>
        </record>
