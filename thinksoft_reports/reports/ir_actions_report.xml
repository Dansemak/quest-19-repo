        <!-- ******************************** Sale Order/Quote **************************************** -->
        <record id="action_report_quotation" model="ir.actions.report">
            <field name="name">Sale Order/Quote</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">thinksoft_reports.report_thinksoft_quotation_template</field>
            <field name="report_file">thinksoft_reports.report_thinksoft_quotation_template</field>
            <field name="print_report_name">(object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order" />
            <field name="paperformat_id" ref="thinksoft_reports.thinksoft_reports_paperformat" />
            <field name="binding_type">report</field>
        </record>
