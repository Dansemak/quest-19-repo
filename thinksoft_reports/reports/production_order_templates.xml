<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--  ////////////////////////////////////////////////////////////////////////////// -->
  <!--  //////////////////////////////////////////////////////////////////////////////
          Thinksoft Inc.
          Notes:
          -This is a custom report for the Manufacturing Order page called Production Order.
          -this report inherits from the built in mrp production order called
            mrp.report_mrporder
          ////////////////////////////////////////////////////////////////////////////// -->
  <!--  ////////////////////////////////////////////////////////////////////////////// -->
  <template id="production_order">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <!--
        As language is not required for all objects.
        So for now, If partner is available in object then pass
        that partner's language.
      -->
        <t t-if="'partner_id' in doc.fields_get()">
          <t t-call="thinksoft_reports.production_order_document" t-lang="doc.partner_id.lang" />
        </t>
        <t t-if="'partner_id' not in doc.fields_get()">
          <t t-call="thinksoft_reports.production_order_document" />
        </t>
      </t>
    </t>
  </template>
  <template name="Custom Production Order header and footer" id="report_production_order_header_footer">
    <div class="header pe-5" style="">
                <style>
                    <!-- @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&amp;family=Sansation:wght@700&amp;display=swap'); -->
                    .header,.footer {
                        font-family: Arial, Helvetica,  sans-serif ;
                      }
                    .top-address{
                        line-height:1; font-size:13px; font-family:Arial, Helvetica,sans-serif;
                      }
                    .title{
                        <!-- font-family:'Oswald', -->
                        font-family:Arial, Helvetica, sans-serif;
                        sans-serif !important;
                        font-size: 24px !important;
                        font-weight: bold !important;
                        text-align: left !important;
                        line-height: 1.2 !important;
                      }
                    .barcode{
                        font-size:14px !important;  margin-top:4px !important; font-weight:bold !important;font-family:Arial, Helvetica,sans-serif;
                      }
                </style>
                <div class="container">
                <div class="row mb-2">
                    <!-- ******************** LOGO ******************** -->
                    <div class="col-4">
                    <div class="">
                        <img class="img img-responsive " style="width: 200px;" src="/thinksoft_reports/static/src/img/quest-logo.jpg" />              
                    </div>
                    </div>
                    <!-- ******************** ADDRESS ******************** -->
                    <div class="col-3 top-address">
                    <p style="">Quest Gasket &amp; Supply Inc<br /> Unit
                        500, 3260 16 Street <br /> Nisku, AB, T9E 1P5 <br /> P: 780.463.4049 | F:
                        780.461.7009</p>
                    </div>
                    <!-- ******************** TITLE ******************** -->
                    <div class="col-5 d-flex justify-content-end" style=" ">
                    <div style="padding:0!important; text-align:center; ">
                        <!-- ******************** BARCODE ******************** -->
                        <span t-field="doc.name"
                        t-options='{"widget": "barcode", "barcode_type": "Code128", "width":200, "height":30}'
                        style="" />
                        <br />
                        <div class="barcode" t-field="doc.name" />
                    </div>
                    <!-- ******************** TITLE ******************** -->
                    <div class="title text-uppercase">
                        Production<br/> Order
                    </div>
                    </div>
                </div>
                </div>
            </div>

            <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
                t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0" />
            </div>
            <!-- <div class="footer "
                style="font-size:11px; width:100%;border-top:3px solid #c30000; padding-top:8px; "> -->
            <div class="footer" style="font-size:11px; width:100%;">
              <div class="container ">
                <div class="row">
                    <div class="col-12">
                    <span class="text-left" style="">Print Date:</span>
                    <span class="ms-2"
                        t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y %H:%M:%S')"
                        style="margin-right: 250px; text-align: right;" />
                    <span style="font-size: 11px; text-align: center; color: #525659;">www.questgasket.com</span>
                    <div style="display: inline-block; float: right;">Page: <span class="page ms-2" /> of <span
                        style="text-align: right;" class="topage" /></div>
                    </div>
                </div>
                </div>
            </div>
  </template>
  <template id="production_order_document">

      <t t-call="thinksoft_reports.report_production_order_header_footer">
        <link rel="stylesheet" t-att-href="'/thinksoft_reports/static/src/css/report_style.css'"/>
        <div class="main_page">
          <!--
                          As language is not required for all objects.
                          So for now, If partner is available in object then pass
                          that partner's language.
                      -->
          <t t-if="'partner_id' in doc.fields_get()">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
          </t>
          <div class="oe_structure" style="">
            <!-- ################################################################ TOP ######################################################################### -->
            <div class="container">
              <div class="row">
                <!-- ********************* SHIP TO ******************************** -->
                <div class="info1 quality-control col-6" style="">
                  <table class="table  text-uppercase table table-hover" data-name="" style="height: 150px; border-collapse:collapse;">
                    <thead>
                      <tr>
                        <th class="text-center" style="border-top-color: #525659; line-height:0.9" colspan="2">
                          <span style="">QUALITY CONTROL</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th style="">
                          <span style="">FIRST STAGE QC</span>
                        </th>
                        <td>
                          <span>MATERIAL QC: </span>
                        </td>
                      </tr>
                      <tr>
                        <th style="">
                          <span style="">SECOND STAGE QC</span>
                        </th>
                        <td>
                          <span>DIMENSION QC: </span>
                        </td>
                      </tr>
                      <tr>
                        <th style="">
                          <span style="">FINAL STAGE QC</span>
                        </th>
                        <td>
                          <span>QUANTITY QC: </span>
                        </td>
                      </tr>
                      <tr>
                        <th style="">
                          <span style="">MANUFACTURED BY:</span>
                        </th>
                        <td></td>
                      </tr>
                    </tbody>
                  </table>

                </div>
                <!-- ************************************** REPORT INFO ******************************************** -->
                <div class="info col-6">
                  <table class=" text-uppercase" style="border-collapse:collapse; " >
                    <tbody style=" ">
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">DATE</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.create_date" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">REQUIRED DELIVERY DATE</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                            <!-- <span class="" t-field="doc.sale_id.commitment_date"/> -->
                            <!-- <t t-set="sol" t-value="doc.move_finished_ids.move_dest_ids"/>
                            <t t-if="sol and sol[0].sale_line_id">
                                <span t-field="sol[0].sale_line_id.order_id.commitment_date"/>
                            </t> -->
                            <span t-field="doc.sale_line_id.order_id.commitment_date"/>
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Manufacturing Order</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.name" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Source Document</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.origin" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Customer Reference</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                            <span t-field="doc.sale_line_id.order_id.client_order_ref"/>
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">SALESPERSON</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.sale_line_id.order_id.user_id" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Responsible</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.user_id" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space: nowrap; border: 1px solid #525659;">
                          <span class="">Shipping Method</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.sale_line_id.order_id.carrier_id.name" />
                        </td>
                      </tr>
                      <tr>
                        <th style="text-align: right; white-space:normal!important; border: 1px solid #525659;">
                          <span class="">CUSTOMER</span>
                        </th>
                        <td style="border: 1px solid #525659;">
                          <span class="" t-field="doc.sale_line_id.order_id.partner_id.name" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="container" style="margin:20px 0 20px;">
              <!-- ************************************** NOTE ******************************************** -->
              <div class="row items">
                <div class="col-md-12 col-xs-12">
                  <!-- <div t-if="doc.sale_id.comment_text" class="mb8  quality-control "
                    style="margin-top: 15px;"> -->
                    <div  class="mb8  quality-control "
                    style="margin-top: 15px;">
                    <table class="table " style="height: 100%; border-collapse:collapse;">
                      <thead>
                        <tr>
                          <th class="text-uppercase text-center"
                            style="border-top-color: #525659; line-height:0.9" colspan="2">
                            <span>COMMENT</span>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td style="text-transform: initial!important;">
                            <span class="" t-field="doc.sale_line_id.order_id.comment_text"/>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div class="container" style="margin:20px 0 20px;">
              <div class="row items">
                <div class="col-md-12 col-xs-12">
                  <div class="">
                    <!-- ********************* FINISHED PRODUCTS LOCATION ******************************** -->
                    <table style="width:100%; ">
                      <thead style="">
                        <div style="clear:both;">
                          <tr>
                            <th style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; width: 40px;">Finished Products Location</th>
                          </tr>
                        </div>
                      </thead>
                      <tbody>
                        <tr class="" style="">
                          <td class="text-center">
                            <span t-field="doc.location_dest_id" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <!-- ************************************** PRODUCTS DETAILS ******************************************** -->
            <div class="container" style="margin:20px 0 20px;">
              <div class="row items">
                <div class="col-md-12 col-xs-12">
                  <div class="">
                    <strong class="mb-3" style="font-size :13px;">Product</strong>
                    <table style="width:100%; ">
                      <thead style="">
                        <div style="clear:both;">
                          <tr>
                            <th style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; text-align: left;">Product</th>
                            <th style="border-top-color: solid #525659;  border-bottom-color: #525659; text-align: left;">Product Description</th>
                            <th style="border-top-color: #525659; border-botttom-color: #525659;">Qty</th>
                          </tr>
                        </div>
                      </thead>
                      <tbody>
                        <td>
                          <span t-field="doc.product_id"/>
                        </td>
                        <td>
                          <span t-esc="doc.sale_line_id.product_id.description"/>
                        </td>
                        <td class="text-center">
                          <span t-field="doc.product_qty"/>
                        </td>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <div class="container" style="margin:20px 0 20px;">
              <div class="row items">
                <div class="col-md-12 col-xs-12">
                  <div class="">
                    <strong class="mb-3" style="font-size :13px;">Work Orders</strong>
                    <table style="width:100%; ">
                      <thead style="">
                        <div style="clear:both;">
                          <tr>
                            <th style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; width: 40px;">Sequences</th>
                            <th style="text-align:center; border-top-color: solid #525659;  border-bottom-color: #525659;">Name</th>
                            <th style="border-top-color: #525659; border-botttom-color: #525659; ">Work Center</th>
                            <th style=" border-top-color: #525659; border-botttom-color: #525659;">No. of Cycles</th>
                            <th colspan="" style=" border-top-color:#525659;">No. of Hours</th>
                          </tr>
                        </div>
                      </thead>
                      <t t-set="sequence" t-value="0" />
                      <tbody>
                        <!-- ###################################### ROW TWO ##################################### -->
                        <tr class="" style="" t-as="line" t-foreach="doc.workorder_ids">
                          <t t-set="sequence" t-value="sequence + 1" />
                          <td>
                            <span t-esc="sequence" />
                          </td>
                          <td>
                            <span t-field="line.name" />
                          </td>
                          <td class="text-center">
                            <span t-field="line.workcenter_id" />
                          </td>
                          <td>
                            <span />
                          </td>
                          <td class="text-center">
                            <span t-field="line.duration_expected" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <div class="container" style="margin:20px 0 20px;">
              <div class="row items">
                <div class="col-md-12 col-xs-12">
                  <div class="">
                    <strong class="mb-3" style="font-size :13px;">Bill Of Material</strong>
                    <table style="width:100%; ">
                      <thead style="">
                        <div style="clear:both;">
                          <tr>
                            <th style="border-left-color: #525659; border-top-color: #525659; border-bottom-color:#525659; text-align: left;">Product</th>
                            <th style=" border-top-color: solid #525659;  border-bottom-color: #525659;" >Qty</th>
                            <th style="border-top-color: #525659; border-botttom-color: #525659;  text-align: left;">Source Location</th>
                            <th style=" border-top-color: #525659; border-botttom-color: #525659;  text-align: left;">Destination Location</th>
                          </tr>
                        </div>
                      </thead>
                      <!-- ###################################### ROW TWO ##################################### -->
                      <tbody>
                        <tr class="" style="" t-as="line" t-foreach="doc.move_raw_ids">
                          <td>
                            <span t-field="line.product_id" />
                          </td>
                          <td class="text-center">
                            <span t-field="line.product_uom_qty" />
                          </td>
                          <td>
                            <span t-field="line.location_id" />
                          </td>
                          <td>
                            <span t-field="line.location_dest_id" />
                          </td>
                        </tr>
                      </tbody>

                      <tbody>
                        <tr class="">
                          <td colspan="" style="">Heat#</td>
                          <td colspan="3" style="">
                            <!-- <span t-field="doc.product_id.heat_number" /> -->
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </t>

  </template>
</odoo>