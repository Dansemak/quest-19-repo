<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_thinksoft_discount" model="ir.ui.view">
        <field name="name">sale.order.view.form.thinksoft.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//list//field[@name='price_unit']" position="after">
                <xpath expr="/form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list//field[@name='discount']" position="move"/>
                <field name="price_unit_discounted" optional="show"/>
            </xpath>

        </field>
    </record>

</odoo>