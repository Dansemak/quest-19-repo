<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_department_action_list" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">mrp.department</field>
        <field name="view_mode">list,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Department
            </p><p>
                Create a new Department
            </p>
        </field>
    </record>

    <record id="mrp_department_view_tree" model="ir.ui.view">
        <field name="name">mrp.department.view.tree</field>
        <field name="model">mrp.department</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="mrp_department_view_form" model="ir.ui.view">
        <field name="name">mrp.department.view.form</field>
        <field name="model">mrp.department</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name" />
                        </div>
                        <h1 class="mb-0">
                            <field name="name" class="mb-0" placeholder="e.g. MTR REQUIRED, MUST PICK UP TODAY, etc" />
                        </h1>
                    </div>
                    <field name="active" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_department_view_search" model="ir.ui.view">
        <field name="name">mrp.department.view.search</field>
        <field name="model">mrp.department</field>
        <field name="arch" type="xml">
            <search>
                <filter name="archive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <menuitem
        id="mrp_menu_mrp_department_action_list"
        action="mrp_department_action_list"
        parent="mrp.menu_mrp_configuration"
        groups="mrp.group_mrp_manager"
        sequence="100"/>

</odoo>