<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_thinksoft_purchase_limit" model="ir.ui.view">
        <field name="name">purchase.order.view.form.thinksoft.purchase.limit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="after">
                <div class="alert alert-warning" role="alert" invisible="purchase_hold != True" style="text-align: center;">
                    <h4>
                        This Purchase Order is over the buyer&#39;s Purchase Limit.<br/>
                        This order has been put on hold. Please contact your Manager.
                    </h4>
                </div>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="purchase_hold"/>
            </xpath>

        </field>
    </record>

</odoo>
