<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_users_form_thinksoft_purchase_limit" model="ir.ui.view">
        <field name="name">res.users.form.thinksoft.purchase.limit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="/form//page[@name='page_security']" position="after">
                <page string="Purchase Limit" name="purchase_limit">
                    <group>
                        <group>
                            <field name="purchase_limit"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>