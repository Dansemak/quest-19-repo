<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_limit_res_user_view_list" model="ir.ui.view">
        <field name="name">purchase.limit.res.users.view.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list create="false" duplicate="false" edit="false" multi_edit="false" default_order="purchase_limit asc">
                <field name="name"/>
                <field name="purchase_limit"/>
            </list>
        </field>
    </record>

    <record id="purchase_limit_res_user_view_form" model="ir.ui.view">
        <field name="name">purchase.limit.res.users.view.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form create="0" duplicate="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_limit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_limit_action_list" model="ir.actions.act_window">
        <field name="name">Purchase Limit</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('purchase_limit_res_user_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('purchase_limit_res_user_view_form')})]"/>
    </record>
    
    <menuitem name="Purchase Limit" id="purchase_limit_menu_root" parent="purchase.menu_purchase_config" action="purchase_limit_action_list" sequence="5"/>

</odoo>
