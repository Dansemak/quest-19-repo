<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_purchase" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- replace Print button action with custom report action -->
            <xpath expr="//header//button=[@name='print_quotation']" position="replace">
                <button string="Print" name="thinksoft_reports.action_report_purchase_order" type="object" groups="base.group_user" data-hotkey="k"/>
            </xpath>

        </field>
    </record>

</odoo>
