<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_thinksoft_actions" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header//button[@name='action_print_pdf']" position="replace">
                <button name="thinksoft_reports.action_report_invoice_thinksoft"
                    type="action"
                    class="oe_highlight"
                    invisible="state != 'posted' or is_being_sent or invoice_pdf_report_id or move_type == 'entry'"
                    string="Print"/>
            </xpath>

            <xpath expr="//header//button[@name='action_print_pdf']" position="replace">
                <button name="thinksoft_reports.action_report_invoice_thinksoft"
                    type="action"
                    invisible="state != 'posted' or (not is_being_sent and not invoice_pdf_report_id)"
                    string="Print"/>
            </xpath>

        </field>
    </record>

</odoo>
