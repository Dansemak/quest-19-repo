<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_thinksoft_actions" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <!-- switching the print button action to print the custom Sale Order report -->
            <xpath expr="//header//button[@name='sale.action_report_saleorder']" position="replace">
                <button string="Print" name="thinksoft_reports.action_report_quotation" type="action" data-hotkey="i" />
            </xpath>

        </field>
    </record>

</odoo>
