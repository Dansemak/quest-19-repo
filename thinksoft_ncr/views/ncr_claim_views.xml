<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ncr_claim_view_list" model="ir.ui.view">
        <field name="name">ncr.claim.view.list</field>
        <field name="model">ncr.claim</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="ncr_claim_view_form" model="ir.ui.view">
        <field name="name">ncr.claim.view.form</field>
        <field name="model">ncr.claim</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button name="button_close" string="Close" type="object" class="oe_highlight" invisible="state in ('closed', 'cancelled')"/>
                    <button name="button_cancel" string="Cancel" type="object" invisible="state in ('closed', 'cancelled')"/>
                    <button name="button_reopen" string="Re-open" type="object" invisible="state == 'open'"/>
                        
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group name="group_main">
                        <group name="group_order_details" string="Order Details">
                            <field name="classification"/>
                            <field name="issue_type"/>
                            <field name="sale_order_id"/>
                            <field name="purchase_order_id"/>
                        </group>
                        <group name="group_ncr_details" string="NCR Details">
                            <field name="date"/>
                            <field name="resolved_by"/>
                            <field name="responsible_id" groups="thinksoft_ncr.ncr_group_manager"/>
                            <field name="severity"/>
                            <field name="cost_impact"/>
                            <field name="resolution_lead_time"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    
    <record id="ncr_claim_action_list" model="ir.actions.act_window">
        <field name="name">NCR</field>
        <field name="res_model">ncr.claim</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="NCR" id="ncr_menu_root">
        <menuitem name="Overview" id="ncr_claim_action" action="ncr_claim_action_list"/>
    </menuitem>

</odoo>