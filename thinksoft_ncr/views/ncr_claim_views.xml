<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ncr_claim_view_list" model="ir.ui.view">
        <field name="name">ncr.claim.view.list</field>
        <field name="model">ncr.claim</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="ncr_claim_view_form" model="ir.ui.view">
        <field name="name">ncr.claim.view.form</field>
        <field name="model">ncr.claim</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="classification"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="ncr_claim_action_list" model="ir.actions.act_window">
        <field name="name">NCR</field>
        <field name="res_model">ncr.claim</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem name="NCR" id="ncr_menu_root">
        <menuitem name="Overview" id="ncr_claim_action" action="ncr_claim_action_list"/>
    </menuitem>

</odoo>