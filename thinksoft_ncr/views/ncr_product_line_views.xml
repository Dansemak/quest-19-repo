<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ncr_product_line_form_view" model="ir.ui.view">
        <field name="name">ncr.product.line.form.view</field>
        <field name="model">ncr.product.line</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="ncr_claim_id" readonly="True" options='{"no_open": True}'/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="True" invisible="not sale_order_id"/>
                            <field name="purchase_order_id" readonly="True" invisible="not purchase_order_id"/>
                            <field name="product_id" options='{"no_create": True}'/>
                            <field name="product_line_desc"/>
                        </group>
                        <group>
                            <field name="product_qty"/>
                            <field name="product_cost"/>
                            <field name="product_subtotal"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>