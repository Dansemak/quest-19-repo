<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">

         <record id="ncr_management" model="ir.module.category">
             <field name="name">NCR</field>
             <field name="description">User access level for NCR App</field>
        </record>

        <record id="ncr_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="ncr_management"/>
        </record>
        <record id="ncr_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="ncr_management"/>
            <field name="implied_ids" eval="[(4, ref('ncr_group_user'))]"/>
        </record>

    </data>
</odoo>